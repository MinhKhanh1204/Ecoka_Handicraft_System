                </div>
            </div>
        </div>
    </div>
</div>
<!-- Fact Start -->
<!-- Testimonial Start -->
<div class="container-fluid testimonial py-5">
    <div class="container py-5">
        <div class="testimonial-header text-center">
            <h4 class="text-primary">Customer Feedback</h4>
            <h1 class="display-5 mb-5 text-dark">Khách hàng nói gì?</h1>
        </div>

        <div id="feedbackLoading" class="text-center py-4">
            <span class="text-muted">Đang tải đánh giá...</span>
        </div>

        <div id="feedbackEmpty" class="text-center py-4 d-none">
            <div class="alert alert-light border rounded-4 shadow-sm">
                Chưa có đánh giá nào.
            </div>
        </div>

        <div id="feedbackCarousel" class="owl-carousel testimonial-carousel d-none">
        </div>
    </div>
</div>
<!-- Testimonial End -->
<script>
    async function loadHomepageFeedbacks(minRating = 4) {
        const loadingEl = document.getElementById('feedbackLoading');
        const emptyEl = document.getElementById('feedbackEmpty');
        const carouselEl = document.getElementById('feedbackCarousel');

        loadingEl.classList.remove('d-none');
        emptyEl.classList.add('d-none');
        carouselEl.classList.add('d-none');
        carouselEl.innerHTML = '';

        try {
            const url = `/Home/GetHomepageFeedbacks?minRating=${minRating}&take=10`;
            const response = await fetch(url);

            if (!response.ok) {
                throw new Error(`HTTP error: ${response.status}`);
            }

            const feedbacks = await response.json();

            loadingEl.classList.add('d-none');

            if (!feedbacks || feedbacks.length === 0) {
                emptyEl.classList.remove('d-none');
                return;
            }

            feedbacks.forEach(item => {
                const fullName = item.customerName || "Khách hàng";
                const comment = item.comment || "Khách hàng chưa để lại nội dung.";
                const rating = item.rating || 0;
                const productName = item.productName || "Sản phẩm";
                const productImage = item.productImage || "/img/fruite-item-1.jpg";

                const stars = renderStars(rating);

                const html = `
                    <div class="testimonial-item bg-light rounded p-4 shadow-sm">
                        <div class="position-relative h-100 d-flex flex-column">
                            <i class="fa fa-quote-right fa-2x text-secondary position-absolute"
                               style="top: 0; right: 0;"></i>

                            <div class="d-flex align-items-center mb-3 pe-4">
                                <img src="${productImage}"
                                     class="rounded"
                                     style="width: 80px; height: 80px; object-fit: cover;"
                                     alt="${escapeHtml(productName)}">

                                <div class="ms-3">
                                    <h5 class="mb-1 text-dark">${escapeHtml(productName)}</h5>
                                    <div class="d-flex">
                                        ${stars}
                                    </div>
                                </div>
                            </div>

                            <div class="mb-3">
                                <p class="mb-0 text-muted">"${escapeHtml(comment)}"</p>
                            </div>

                            <div class="mt-auto pt-3 border-top">
                                <strong class="text-dark">${escapeHtml(fullName)}</strong>
                                <div class="small text-muted">Khách hàng đã mua sản phẩm</div>
                            </div>
                        </div>
                    </div>
                `;

                carouselEl.insertAdjacentHTML('beforeend', html);
            });

            carouselEl.classList.remove('d-none');

            if ($(carouselEl).hasClass('owl-loaded')) {
                $(carouselEl).trigger('destroy.owl.carousel');
                $(carouselEl).removeClass('owl-loaded');
                $(carouselEl).find('.owl-stage-outer').children().unwrap();
            }

            $(carouselEl).owlCarousel({
                loop: true,
                margin: 24,
                nav: false,
                dots: true,
                autoplay: true,
                autoplayTimeout: 4000,
                smartSpeed: 800,
                responsive: {
                    0: { items: 1 },
                    768: { items: 2 },
                    1200: { items: 3 }
                }
            });
        } catch (error) {
            console.error("Load homepage feedbacks failed:", error);
            loadingEl.classList.add('d-none');
            emptyEl.classList.remove('d-none');
        }
    }

    function renderStars(rating) {
        let html = '';
        const rounded = Math.round(rating);

        for (let i = 1; i <= 5; i++) {
            html += i <= rounded
                ? '<i class="fas fa-star text-primary"></i>'
                : '<i class="fas fa-star text-muted"></i>';
        }

        return html;
    }

    function escapeHtml(text) {
        const div = document.createElement('div');
        div.innerText = text ?? '';
        return div.innerHTML;
    }

    document.addEventListener('DOMContentLoaded', function () {
        loadHomepageFeedbacks(4);
    });
</script>