@model List<MVCApplication.Models.DTOs.ProductDto>
@using System.Globalization

@{
    ViewData["Title"] = "Home Page";
}
<style>
    .hero-header {
        background: linear-gradient(135deg, #f8fffb 0%, #eefaf3 100%);
    }

    .hero-slider {
        border-radius: 24px;
    }

    .hero-slide-img {
        height: 420px;
        object-fit: cover;
    }

    .hero-caption {
        left: 24px;
        right: 24px;
        bottom: 24px;
        text-align: left;
        background: rgba(0, 0, 0, 0.35);
        padding: 20px;
        border-radius: 20px;
        backdrop-filter: blur(4px);
    }

        .hero-caption h5 {
            color: #fff;
            font-size: 1.25rem;
            font-weight: 600;
            margin-bottom: 12px;
        }

    .hero-badge {
        display: inline-block;
        margin-bottom: 10px;
        padding: 6px 14px;
        background: #81c408;
        color: #fff;
        border-radius: 999px;
        font-size: 0.85rem;
        font-weight: 600;
    }

    @@media (max-width: 991.98px) {
        .hero-slide-img {
            height: 320px;
        }
    }

    .product-media {
        height: 220px;
        background-size: cover;
        background-position: center;
        position: relative;
    }

    .product-badge {
        position: absolute;
        top: 12px;
        left: 12px;
        background: #6c757d;
        color: white;
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 12px;
    }

    .discount-badge {
        position: absolute;
        top: 12px;
        right: 12px;
        background: #dc3545;
        color: white;
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 12px;
    }

    .product-title {
        font-weight: 600;
    }

    .price-current {
        font-weight: 700;
    }

    .price-old {
        text-decoration: line-through;
        color: #888;
        font-size: 13px;
    }

    .vesitable-item {
        transition: all 0.25s ease;
        box-shadow: 0 0.5rem 1rem rgba(0,0,0,.06);
    }

    .vesitable-item:hover {
        transform: translateY(-6px);
        box-shadow: 0 1rem 2rem rgba(0,0,0,.10);
     }

    .vesitable-img img {
        transition: transform 0.3s ease;
    }

    .vesitable-item:hover .vesitable-img img {
        transform: scale(1.04);
    }
</style>
<!-- Hero Start -->
<div class="container-fluid py-5 mb-5 hero-header">
    <div class="container py-5">
        <div class="row g-5 align-items-center">
            <div class="col-md-12 col-lg-7">
                <h5 class="mb-3 text-secondary text-uppercase">Eco Handicraft Collection</h5>
                <h1 class="mb-4 display-4 text-primary fw-bold">
                    Sản phẩm thủ công thân thiện môi trường
                </h1>
                <p class="mb-4 text-dark fs-5">
                    Khám phá các sản phẩm làm từ lục bình, bã mía, sợi chuối, tre và gáo dừa
                    với phong cách tự nhiên, bền vững và tinh tế.
                </p>

                <div class="d-flex flex-wrap gap-3">
                    <a asp-controller="Shop"
                       asp-action="Index"
                       class="btn btn-primary rounded-pill px-4 py-3 text-white">
                        Xem sản phẩm
                    </a>

                    <a asp-controller="Shop"
                       asp-action="Index"
                       class="btn btn-outline-secondary rounded-pill px-4 py-3">
                        Danh mục nổi bật
                    </a>
                </div>
            </div>

            <div class="col-md-12 col-lg-5">
                <div id="carouselId" class="carousel slide position-relative hero-slider" data-bs-ride="carousel">
                    <div class="carousel-inner rounded-4 shadow overflow-hidden">

                        <div class="carousel-item active">
                            <img src="~/sliders/luc_binh.png"
                                 class="img-fluid w-100 hero-slide-img"
                                 alt="Sản phẩm làm từ lục bình">
                            <div class="carousel-caption hero-caption">
                                <span class="hero-badge">Lục Bình</span>
                                <h5>Sản phẩm làm từ lục bình</h5>
                                <a asp-controller="Shop"
                                   asp-action="Index"
                                   class="btn btn-light btn-sm rounded-pill px-3">
                                    Xem ngay
                                </a>
                            </div>
                        </div>

                        <div class="carousel-item">
                            <img src="~/sliders/ba_mia.png"
                                 class="img-fluid w-100 hero-slide-img"
                                 alt="Sản phẩm làm từ bã mía">
                            <div class="carousel-caption hero-caption">
                                <span class="hero-badge">Bã Mía</span>
                                <h5>Sản phẩm làm từ bã mía</h5>
                                <a asp-controller="Shop"
                                   asp-action="Index"
                                   class="btn btn-light btn-sm rounded-pill px-3">
                                    Xem ngay
                                </a>
                            </div>
                        </div>

                        <div class="carousel-item">
                            <img src="~/sliders/soi_chuoi.png"
                                 class="img-fluid w-100 hero-slide-img"
                                 alt="Sản phẩm làm từ sợi chuối">
                            <div class="carousel-caption hero-caption">
                                <span class="hero-badge">Sợi Chuối</span>
                                <h5>Sản phẩm làm từ sợi chuối</h5>
                                <a asp-controller="Shop"
                                   asp-action="Index"
                                   class="btn btn-light btn-sm rounded-pill px-3">
                                    Xem ngay
                                </a>
                            </div>
                        </div>

                        <div class="carousel-item">
                            <img src="~/sliders/tre.png"
                                 class="img-fluid w-100 hero-slide-img"
                                 alt="Sản phẩm làm từ tre">
                            <div class="carousel-caption hero-caption">
                                <span class="hero-badge">Tre</span>
                                <h5>Sản phẩm làm từ tre</h5>
                                <a asp-controller="Shop"
                                   asp-action="Index"
                                   class="btn btn-light btn-sm rounded-pill px-3">
                                    Xem ngay
                                </a>
                            </div>
                        </div>

                        <div class="carousel-item">
                            <img src="~/sliders/gao_dua.png"
                                 class="img-fluid w-100 hero-slide-img"
                                 alt="Sản phẩm làm từ gáo dừa">
                            <div class="carousel-caption hero-caption">
                                <span class="hero-badge">Gáo Dừa</span>
                                <h5>Sản phẩm làm từ gáo dừa</h5>
                                <a asp-controller="Shop"
                                   asp-action="Index"
                                   class="btn btn-light btn-sm rounded-pill px-3">
                                    Xem ngay
                                </a>
                            </div>
                        </div>

                    </div>

                    <button class="carousel-control-prev" type="button" data-bs-target="#carouselId" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon rounded-circle p-3 bg-dark bg-opacity-50" aria-hidden="true"></span>
                        <span class="visually-hidden">Previous</span>
                    </button>

                    <button class="carousel-control-next" type="button" data-bs-target="#carouselId" data-bs-slide="next">
                        <span class="carousel-control-next-icon rounded-circle p-3 bg-dark bg-opacity-50" aria-hidden="true"></span>
                        <span class="visually-hidden">Next</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Hero End -->
<!-- Featurs Section Start -->
<div class="container-fluid featurs py-5">
    <div class="container py-5">
        <div class="row g-4">
            <div class="col-md-6 col-lg-3">
                <div class="featurs-item text-center rounded bg-light p-4">
                    <div class="featurs-icon btn-square rounded-circle bg-secondary mb-5 mx-auto">
                        <i class="fas fa-car-side fa-3x text-white"></i>
                    </div>
                    <div class="featurs-content text-center">
                        <h5>Free Shipping</h5>
                        <p class="mb-0">Free on order over $300</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="featurs-item text-center rounded bg-light p-4">
                    <div class="featurs-icon btn-square rounded-circle bg-secondary mb-5 mx-auto">
                        <i class="fas fa-user-shield fa-3x text-white"></i>
                    </div>
                    <div class="featurs-content text-center">
                        <h5>Security Payment</h5>
                        <p class="mb-0">100% security payment</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="featurs-item text-center rounded bg-light p-4">
                    <div class="featurs-icon btn-square rounded-circle bg-secondary mb-5 mx-auto">
                        <i class="fas fa-exchange-alt fa-3x text-white"></i>
                    </div>
                    <div class="featurs-content text-center">
                        <h5>30 Day Return</h5>
                        <p class="mb-0">30 day money guarantee</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="featurs-item text-center rounded bg-light p-4">
                    <div class="featurs-icon btn-square rounded-circle bg-secondary mb-5 mx-auto">
                        <i class="fa fa-phone-alt fa-3x text-white"></i>
                    </div>
                    <div class="featurs-content text-center">
                        <h5>24/7 Support</h5>
                        <p class="mb-0">Support every time fast</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Featurs Section End -->
<!-- Product Slider Start -->
<div class="container-fluid vesitable py-5">
    <div class="container py-5">
        <div class="text-center mx-auto mb-5" style="max-width: 800px;">
            <h5 class="text-primary text-uppercase">Featured Products</h5>
            <h1 class="mb-3">Sản phẩm khuyến mại</h1>
            <p class="text-muted mb-0">
                Khám phá các sản phẩm nổi bật đang được quan tâm nhất.
            </p>
        </div>

        <div class="owl-carousel vegetable-carousel justify-content-center">
            @if (Model != null && Model.Any())
            {
                foreach (var p in Model)
                {
                    var discountPct = p.OriginalPrice > 0
                    ? (int)Math.Round((double)((p.OriginalPrice - p.FinalPrice) / p.OriginalPrice * 100))
                    : 0;

                    <div class="border border-primary rounded position-relative vesitable-item bg-white">
                        <div class="vesitable-img position-relative overflow-hidden">
                            <img src="@(string.IsNullOrEmpty(p.MainImage) ? Url.Content("~/img/fruite-item-1.jpg") : p.MainImage)"
                                 class="img-fluid w-100 rounded-top"
                                 alt="@p.ProductName"
                                 style="height: 240px; object-fit: cover;">

                            <div class="text-white bg-primary px-3 py-1 rounded position-absolute"
                                 style="top: 10px; left: 10px;">
                                @(string.IsNullOrWhiteSpace(p.CategoryName) ? "Product" : p.CategoryName)
                            </div>

                            @if (discountPct > 0)
                            {
                                <div class="text-white bg-danger px-3 py-1 rounded position-absolute"
                                     style="top: 10px; right: 10px;">
                                    -@discountPct%
                                </div>
                            }
                </div>

                <div class="p-4 rounded-bottom d-flex flex-column" style="min-height: 220px;">
                    <h4 class="text-truncate" title="@p.ProductName">@p.ProductName</h4>

                    <p class="text-muted mb-3" style="min-height: 48px;">
                        @(string.IsNullOrWhiteSpace(p.Description)
                                                ? "Sản phẩm chất lượng cao, phù hợp cho nhu cầu hằng ngày."
                                                : p.Description)
                    </p>

                            <div class="mt-auto d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <div>
                                    <p class="text-dark fs-5 fw-bold mb-0">
                                        @p.FinalPrice.ToString("N0", CultureInfo.GetCultureInfo("vi-VN")) ₫
                                    </p>

                            @if (p.OriginalPrice > p.FinalPrice)
                                    {
                                        <small class="text-decoration-line-through text-muted">
                                            @p.OriginalPrice.ToString("N0", CultureInfo.GetCultureInfo("vi-VN")) ₫
                                        </small>
                                    } 
                                </div>

                                <a asp-controller="Shop"
                                   asp-action="Detail"
                                   asp-route-id="@p.ProductID"
                                   class="btn border border-secondary rounded-pill px-3 text-primary">
                                    <i class="fa fa-eye me-2 text-primary"></i> Xem
                                </a>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="text-center w-100 py-5">
                    <div class="alert alert-light border rounded-4 shadow-sm">
                        Không có sản phẩm để hiển thị.
                    </div>
                </div>
            }
        </div>
    </div>
</div>
<!-- Product Slider End -->
<!-- Banner Section Start -->
<div class="container-fluid banner bg-light my-5">
    <div class="container py-5">
        <div class="row g-4 align-items-center">

            <div class="col-lg-6">
                <h5 class="text-secondary text-uppercase mb-3">
                    Eco Handicraft Collection
                </h5>

                <h1 class="display-4 text-primary fw-bold mb-4">
                    Sản phẩm thủ công thân thiện môi trường
                </h1>

                <p class="mb-4 text-dark">
                    Khám phá các sản phẩm độc đáo được làm từ lục bình, bã mía,
                    sợi chuối, tre và gáo dừa. Tất cả đều mang phong cách tự nhiên,
