@model ProfileViewModel
@{
    ViewData["Title"] = "Profle";
}
<!-- Single Page Header start -->
<div class="container-fluid page-header py-5">
    <h1 class="text-center text-white display-6">Hồ sơ</h1>
    <ol class="breadcrumb justify-content-center mb-0">
        <li class="breadcrumb-item"><a href="Home">Trang chủ</a></li>
        <li class="breadcrumb-item active text-white">Hồ sơ</li>
    </ol>
</div>
<!-- Single Page Header End -->
<style>
    .profile-container {
        min-height: 80vh;
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        padding: 50px 0;
    }

    .profile-card {
        border: none;
        border-radius: 20px;
        box-shadow: 0 15px 35px rgba(0,0,0,0.1);
        background: #fff;
        overflow: hidden;
    }

    .profile-sidebar {
        background: linear-gradient(135deg, #81c408 0%, #619406 100%);
        color: #fff;
        padding: 40px;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    .avatar-wrapper {
        position: relative;
        width: 180px;
        height: 180px;
        margin-bottom: 25px;
        border-radius: 50%;
        padding: 5px;
        background: rgba(255, 255, 255, 0.2);
        box-shadow: 0 10px 25px rgba(0,0,0,0.2);
    }

    .avatar-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 50%;
        border: 4px solid #fff;
    }

    .avatar-upload-btn {
        position: absolute;
        bottom: 5px;
        right: 5px;
        width: 45px;
        height: 45px;
        border-radius: 50%;
        background: #fff;
        color: #81c408;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        transition: all 0.3s ease;
    }

    .avatar-upload-btn:hover {
        transform: scale(1.1);
        background: #f8f9fa;
    }

    .profile-main {
        padding: 50px;
    }

    .form-label-custom {
        font-weight: 600;
        color: #495057;
        margin-bottom: 8px;
        font-size: 0.9rem;
    }

    .input-group-custom {
        position: relative;
        margin-bottom: 25px;
    }

    .input-group-custom i {
        position: absolute;
        left: 18px;
        top: 50%;
        transform: translateY(-50%);
        color: #adb5bd;
        z-index: 10;
        transition: color 0.3s ease;
    }

    .form-control-modern {
        border-radius: 12px;
        padding: 12px 20px 12px 45px;
        border: 1px solid #dee2e6;
        transition: all 0.3s ease;
        background-color: #f8f9fa;
    }

    .form-control-modern:focus {
        box-shadow: 0 0 0 0.25rem rgba(129, 196, 8, 0.15);
        border-color: #81c408;
        background-color: #fff;
    }

    .form-control-modern[readonly] {
        background-color: #e9ecef;
        opacity: 0.8;
        cursor: not-allowed;
    }

    .input-group-custom:focus-within i {
        color: #81c408;
    }

    .btn-save-profile {
        background: #81c408;
        border: none;
        border-radius: 12px;
        padding: 14px 30px;
        font-weight: 600;
        transition: all 0.3s ease;
        color: #fff;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .btn-save-profile:hover {
        background: #619406;
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(129, 196, 8, 0.3);
        color: #fff;
    }

    .select-modern {
        appearance: none;
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3e%3cpath fill='none' stroke='%23343a40' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M2 5l6 6 6-6'/%3e%3c/svg%3e");
        background-repeat: no-repeat;
        background-position: right 1rem center;
        background-size: 16px 12px;
    }
</style>

<div class="profile-container">
    <div class="container">
        <div class="profile-card mx-auto">
            <form asp-action="Profile" asp-controller="Account" method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="AccountId" />
                <div class="row g-0">
                    <div class="col-lg-4 profile-sidebar">
                        <div class="avatar-wrapper">
                            @if (Model.Avatar != null)
                            {
                                <img id="avatarPreview" src="@Model.Avatar" class="avatar-img" alt="Avatar" />
                            }
                            else
                            {
                                <img id="avatarPreview" src="https://via.placeholder.com/200" class="avatar-img" alt="Placeholder" />
                            }
                            <label for="avatarInput" class="avatar-upload-btn">
                                <i class="fas fa-camera"></i>
                            </label>
                            <input type="file" asp-for="Avatar" id="avatarInput" accept="image/*" class="d-none">
                        </div>
                        <h3 class="fw-bold mb-1">@Model.FullName</h3>
                        <p class="opacity-75 mb-4">@@@Model.Username</p>
                        
                        <div class="w-100 px-4 mt-2">
                            <hr class="bg-white opacity-25">
                            <div class="d-flex justify-content-between small opacity-75 mb-2">
                                <span>Thành viên từ</span>
                                <span>Tháng 3, 2024</span>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-8 profile-main">
                        <div class="d-flex align-items-center mb-5">
                            <div class="btn-square bg-primary bg-opacity-10 rounded-circle me-3">
                                <i class="fas fa-user-edit text-primary"></i>
                            </div>
                            <h3 class="fw-bold mb-0">Hồ sơ cá nhân</h3>
                        </div>

                        <div class="row g-4">
                            <div class="col-md-6 text-start">
                                <label class="form-label-custom">Tên người dùng</label>
                                <div class="input-group-custom">
                                    <i class="fas fa-at"></i>
                                    <input type="text" asp-for="Username" class="form-control form-control-modern" readonly>
                                </div>
                            </div>
                            <div class="col-md-6 text-start">
                                <label class="form-label-custom">Email</label>
                                <div class="input-group-custom">
                                    <i class="fas fa-envelope"></i>
                                    <input type="text" asp-for="Email" class="form-control form-control-modern" readonly>
                                </div>
                            </div>
                        </div>

                        <div class="mb-4 text-start">
                            <label class="form-label-custom">Họ và tên*</label>
                            <div class="input-group-custom">
                                <i class="fas fa-id-card"></i>
                                <input type="text" asp-for="FullName" class="form-control form-control-modern" placeholder="Nhập họ và tên đầy đủ">
                            </div>
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="row g-4 mb-4">
                            <div class="col-md-6 text-start">
                                <label class="form-label-custom">Ngày sinh</label>
                                <div class="input-group-custom">
                                    <i class="fas fa-calendar-alt"></i>
                                    <input asp-for="DateOfBirth" type="date" class="form-control form-control-modern">
                                </div>
                            </div>
                            <div class="col-md-6 text-start">
                                <label class="form-label-custom">Giới tính</label>
                                <div class="input-group-custom">
                                    <i class="fas fa-venus-mars"></i>
                                    <select asp-for="Gender" class="form-control form-control-modern select-modern">
                                        <option value="Male">Nam</option>
                                        <option value="Female">Nữ</option>
                                        <option value="Other">Khác</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="row g-4 mb-5">
                            <div class="col-md-6 text-start">
                                <label class="form-label-custom">Số điện thoại</label>
                                <div class="input-group-custom">
                                    <i class="fas fa-phone"></i>
                                    <input type="text" asp-for="Phone" class="form-control form-control-modern" placeholder="Số điện thoại">
                                </div>
                            </div>
                            <div class="col-md-6 text-start">
                                <label class="form-label-custom">Địa chỉ</label>
                                <div class="input-group-custom">
                                    <i class="fas fa-map-marker-alt"></i>
                                    <input type="text" asp-for="Address" class="form-control form-control-modern" placeholder="Địa chỉ của bạn">
                                </div>
                            </div>
                        </div>

                        <div class="text-end pt-2">
                            <button type="submit" class="btn btn-save-profile">
                                <i class="fas fa-save me-2"></i> Lưu hồ sơ
                            </button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById("avatarInput").addEventListener("change", function () {
            const file = this.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    document.getElementById("avatarPreview").src = e.target.result;
                }
                reader.readAsDataURL(file);
            }
        });
    </script>
}