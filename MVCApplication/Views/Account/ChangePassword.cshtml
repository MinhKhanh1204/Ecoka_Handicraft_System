@model MVCApplication.Models.ChangePasswordViewModel

@{
    ViewData["Title"] = "Đổi mật khẩu";
}

<!-- Single Page Header start -->
<div class="container-fluid page-header py-5">
    <h1 class="text-center text-white display-6">Đổi mật khẩu</h1>
    <ol class="breadcrumb justify-content-center mb-0">
        <li class="breadcrumb-item"><a href="/Home">Trang chủ</a></li>
        <li class="breadcrumb-item"><a href="/Account/Profile">Tài khoản</a></li>
        <li class="breadcrumb-item active text-white">Đổi mật khẩu</li>
    </ol>
</div>
<!-- Single Page Header End -->

@section Styles {
    <style>
        .change-password-container {
            min-height: 70vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
            padding: 60px 0;
        }

        .password-card {
            border: none;
            border-radius: 24px;
            box-shadow: 0 20px 50px rgba(0,0,0,0.08);
            overflow: hidden;
            background: #fff;
            max-width: 500px;
            width: 100%;
            padding: 50px;
        }

        .header-icon {
            width: 80px;
            height: 80px;
            background: rgba(129, 196, 8, 0.1);
            color: #81c408;
            border-radius: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            margin: 0 auto 30px;
        }

        .form-control-modern {
            border-radius: 12px;
            padding: 12px 20px 12px 45px;
            border: 1px solid #dee2e6;
            transition: all 0.3s ease;
            background-color: #f8f9fa;
        }

        .form-control-modern:focus {
            box-shadow: 0 0 0 0.25rem rgba(129, 196, 8, 0.15);
            border-color: #81c408;
            background-color: #fff;
        }

        .input-group-custom {
            position: relative;
            margin-bottom: 25px;
        }

        .input-group-custom i {
            position: absolute;
            left: 18px;
            top: 50%;
            transform: translateY(-50%);
            color: #adb5bd;
            z-index: 10;
            transition: all 0.3s ease;
        }

        .input-group-custom:focus-within i {
            color: #81c408;
        }

        .form-label-custom {
            font-weight: 700;
            font-size: 0.9rem;
            color: #495057;
            margin-bottom: 8px;
            display: block;
        }

        .btn-save-password {
            background: linear-gradient(135deg, #81c408 0%, #619406 100%);
            border: none;
            border-radius: 12px;
            padding: 15px;
            font-weight: 700;
            transition: all 0.3s ease;
            color: #fff;
            width: 100%;
            box-shadow: 0 10px 20px rgba(129, 196, 8, 0.2);
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-top: 20px;
        }

        .btn-save-password:hover {
            transform: translateY(-2px);
            box-shadow: 0 15px 30px rgba(129, 196, 8, 0.3);
            color: #fff;
        }

        .btn-cancel-link {
            color: #adb5bd;
            text-decoration: none;
            font-weight: 600;
            font-size: 0.9rem;
            transition: color 0.3s;
            display: inline-block;
            margin-top: 20px;
        }

        .btn-cancel-link:hover {
            color: #6c757d;
        }
    </style>
}

<div class="change-password-container">
    <div class="password-card text-center">
        <div class="header-icon">
            <i class="fas fa-shield-alt"></i>
        </div>
        
        <h3 class="fw-bold mb-2">Đổi mật khẩu</h3>
        <p class="text-muted small mb-5">Đảm bảo tài khoản của bạn luôn được bảo vệ tốt nhất</p>

        @if (TempData["error"] != null)
        {
            <div class="alert bg-danger-subtle text-danger border-0 small py-3 mb-4" style="border-radius: 12px;">
                <i class="fas fa-exclamation-triangle me-2"></i> @TempData["error"]
            </div>
        }

        <form asp-action="ChangePassword" method="post" class="text-start">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="mb-4">
                <label class="form-label-custom">Mật khẩu hiện tại</label>
                <div class="input-group-custom">
                    <i class="fas fa-unlock-alt"></i>
                    <input asp-for="OldPassword" type="password" class="form-control form-control-modern" placeholder="••••••••" required>
                </div>
                <span asp-validation-for="OldPassword" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label class="form-label-custom">Mật khẩu mới</label>
                <div class="input-group-custom">
                    <i class="fas fa-lock"></i>
                    <input asp-for="NewPassword" type="password" class="form-control form-control-modern" placeholder="••••••••" required>
                </div>
                <span asp-validation-for="NewPassword" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label class="form-label-custom">Xác nhận mật khẩu</label>
                <div class="input-group-custom">
                    <i class="fas fa-check-double"></i>
                    <input asp-for="ConfirmPassword" type="password" class="form-control form-control-modern" placeholder="••••••••" required>
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-save-password">
                Lưu thay đổi <i class="fas fa-arrow-right ms-2"></i>
            </button>

            <div class="text-center mt-3">
                <a asp-controller="Account" asp-action="Profile" class="btn-cancel-link">
                    <i class="fas fa-chevron-left me-1 small"></i> Quay lại trang cá nhân
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
