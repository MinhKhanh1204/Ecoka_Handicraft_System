@{
    ViewData["Title"] = "Login";
}
@model LoginViewModel
<!-- Single Page Header start -->
<div class="container-fluid page-header py-5">
    <h1 class="text-center text-white display-6">Đăng nhập</h1>
    <ol class="breadcrumb justify-content-center mb-0">
        <li class="breadcrumb-item"><a href="/Home">Trang chủ</a></li>
        <li class="breadcrumb-item active text-white">Đăng nhập</li>
    </ol>
</div>
<!-- Single Page Header End -->

<!-- Start -->
<div class="container-fluid contact py-5">
    <div class="container py-5">
        <div class="p-5 bg-light rounded">
            <div class="row g-4">
                <div class="col-lg-7">
                    <form asp-action="Login" method="post">
                        <div asp-validation-summary="All" style="color:red"></div>
                        <input asp-for="Email" type="email" class="w-100 form-control border-0 py-3 mb-4" placeholder="Email của bạn">
                        <span asp-validation-for="Email" style="color:red"></span>
                        <input asp-for="Password" type="password" class="w-100 form-control border-0 py-3 mb-2" placeholder="Nhập mật khẩu">
                        <span asp-validation-for="Password" style="color:red"></span>
                        <div class="text-end mb-4">
                            <a asp-action="ForgotPassword" class="text-primary">Quên mật khẩu?</a>
                        </div>
                        <button class="w-100 btn form-control border-secondary py-3 bg-white text-primary " type="submit">Đăng nhập</button>
                        <a class="w-100 btn form-control py-3 bg-primary text-white" style="margin-top: 10px" href="/Account/Register">Đăng ký thành viên</a>
                        <div style="text-align: center; margin-top: 10px">
                        <a asp-controller="Account" asp-action="LoginGoogle" class="btn btn-danger">
                            Đăng nhập với Google
                        </a>
 
                        <a asp-controller="Account" asp-action="LoginFacebook" class="btn btn-secondary">
                            Đăng nhập với Facebook
                            </a>
                        </div>

                    </form>
                </div>
                <div class="col-lg-5">
                    <div class="d-flex p-4 rounded mb-4 bg-white">
                        <i class="fas fa-map-marker-alt fa-2x text-primary me-4"></i>
                        <div>
                            <h4>Địa chỉ</h4>
                            <p class="mb-2">123 Street New York.USA</p>
                        </div>
                    </div>
                    <div class="d-flex p-4 rounded mb-4 bg-white">
                        <i class="fas fa-envelope fa-2x text-primary me-4"></i>
                        <div>
                            <h4>Email liên hệ</h4>
                            <p class="mb-2">info@example.com</p>
                        </div>
                    </div>
                    <div class="d-flex p-4 rounded bg-white">
                        <i class="fa fa-phone-alt fa-2x text-primary me-4"></i>
                        <div>
                            <h4>Điện thoại</h4>
                            <p class="mb-2">(+012) 3456 7890</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- End -->
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}