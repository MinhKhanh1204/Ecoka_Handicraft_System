@{
    ViewData["Title"] = "Login";
}
@model LoginViewModel
<!-- Single Page Header start -->
<div class="container-fluid page-header py-5">
    <h1 class="text-center text-white display-6">Đăng nhập</h1>
    <ol class="breadcrumb justify-content-center mb-0">
        <li class="breadcrumb-item"><a href="/Home">Trang chủ</a></li>
        <li class="breadcrumb-item active text-white">Đăng nhập</li>
    </ol>
</div>
<!-- Single Page Header End -->

<style>
    .login-container {
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
    }

    .login-card {
        border: none;
        border-radius: 20px;
        box-shadow: 0 15px 35px rgba(0,0,0,0.1);
        overflow: hidden;
        background: #fff;
        max-width: 1000px;
        width: 100%;
    }

    .login-info-section {
        background: linear-gradient(135deg, #81c408 0%, #619406 100%);
        color: #fff;
        padding: 60px;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .login-form-section {
        padding: 60px;
    }

    .form-control-modern {
        border-radius: 12px;
        padding: 12px 20px 12px 45px;
        border: 1px solid #dee2e6;
        transition: all 0.3s ease;
        background-color: #f8f9fa;
    }

        .form-control-modern:focus {
            box-shadow: 0 0 0 0.25rem rgba(129, 196, 8, 0.15);
            border-color: #81c408;
            background-color: #fff;
        }

    .input-group-custom {
        position: relative;
        margin-bottom: 20px;
    }

        .input-group-custom i {
            position: absolute;
            left: 18px;
            top: 50%;
            transform: translateY(-50%);
            color: #adb5bd;
            z-index: 10;
            transition: color 0.3s ease;
        }

        .input-group-custom:focus-within i {
            color: #81c408;
        }

    .btn-login {
        background: #81c408;
        border: none;
        border-radius: 12px;
        padding: 14px;
        font-weight: 600;
        transition: all 0.3s ease;
        color: #fff;
    }

        .btn-login:hover {
            background: #619406;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(129, 196, 8, 0.3);
            color: #fff;
        }

    .btn-register-outline {
        border: 2px solid #81c408;
        color: #81c408;
        border-radius: 12px;
        padding: 12px;
        font-weight: 600;
        transition: all 0.3s ease;
    }

        .btn-register-outline:hover {
            background: #81c408;
            color: #fff;
        }

    .social-btns {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 15px;
    }

    .btn-social {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 12px;
        border-radius: 12px;
        font-weight: 500;
        transition: all 0.3s ease;
        text-decoration: none;
        font-size: 0.9rem;
    }

    .btn-google {
        background-color: #fff;
        border: 1px solid #dee2e6;
        color: #495057;
    }

        .btn-google:hover {
            background-color: #f8f9fa;
            border-color: #ced4da;
            box-shadow: 0 4px 10px rgba(0,0,0,0.05);
        }

    .btn-facebook {
        background-color: #1877f2;
        color: #fff;
        border: none;
    }

        .btn-facebook:hover {
            background-color: #166fe5;
            box-shadow: 0 4px 10px rgba(24, 119, 242, 0.3);
            color: #fff;
        }

    .btn-social i {
        font-size: 1.2rem;
        margin-right: 10px;
    }

    .divider {
        display: flex;
        align-items: center;
        text-align: center;
        margin: 25px 0;
        color: #adb5bd;
    }

        .divider::before, .divider::after {
            content: '';
            flex: 1;
            border-bottom: 1px solid #dee2e6;
        }

        .divider:not(:empty)::before {
            margin-right: .5em;
        }

        .divider:not(:empty)::after {
            margin-left: .5em;
        }

    .brand-logo {
        font-family: 'Raleway', sans-serif;
        font-weight: 800;
        font-size: 2.5rem;
        margin-bottom: 20px;
    }
</style>

<div class="login-container py-5">
    <div class="container">
        <div class="login-card mx-auto">
            <div class="row g-0">
                <div class="col-lg-6 d-none d-lg-flex login-info-section">
                    <div class="brand-logo">Ecoka</div>
                    <h2 class="display-6 fw-bold mb-4">Chào mừng bạn quay trở lại!</h2>
                    <p class="fs-5 opacity-75 mb-5">Đăng nhập để tiếp tục khám phá những sản phẩm thủ công thân thiện với môi trường của chúng tôi.</p>

                    <div class="mt-4">
                        <div class="d-flex align-items-center mb-3">
                            <i class="fas fa-check-circle me-3 fs-4"></i>
                            <span>Nhiều ưu đãi hấp dẫn cho thành viên</span>
                        </div>
                        <div class="d-flex align-items-center mb-3">
                            <i class="fas fa-check-circle me-3 fs-4"></i>
                            <span>Theo dõi đơn hàng dễ dàng</span>
                        </div>
                        <div class="d-flex align-items-center">
                            <i class="fas fa-check-circle me-3 fs-4"></i>
                            <span>Thanh toán bảo mật và nhanh chóng</span>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6 login-form-section">
                    <div class="text-center mb-5 d-lg-none">
                        <h1 class="text-primary fw-bold">Ecoka</h1>
                        <h3 class="fw-bold">Đăng nhập</h3>
                    </div>
                    <div class="d-none d-lg-block mb-5">
                        <h3 class="fw-bold">Đăng nhập</h3>
                        <p class="text-muted">Vui lòng nhập thông tin tài khoản của bạn</p>
                    </div>

                    <form asp-action="Login" method="post">
                        <div asp-validation-summary="All" class="text-danger mb-3 small"></div>

                        <div class="input-group-custom">
                            <i class="fas fa-envelope"></i>
                            <input asp-for="Email" type="email" class="form-control form-control-modern" placeholder="Email của bạn">
                        </div>

                        <div class="input-group-custom">
                            <i class="fas fa-lock"></i>
                            <input asp-for="Password" type="password" class="form-control form-control-modern" placeholder="Mật khẩu">
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="rememberMe">
                                <label class="form-check-label text-muted small" for="rememberMe">Ghi nhớ tôi</label>
                            </div>
                            <a asp-action="ForgotPassword" class="text-primary small text-decoration-none fw-bold">Quên mật khẩu?</a>
                        </div>

                        <button class="w-100 btn btn-login mb-4" type="submit">Đăng nhập</button>

                        <div class="divider">Hoặc tiếp tục với</div>

                        <div class="social-btns mb-4">
                            <a asp-controller="Account" asp-action="LoginGoogle" class="btn btn-social btn-google">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 48 48" class="me-2">
                                    <path fill="#FFC107" d="M43.611,20.083H42V20H24v8h11.303c-1.649,4.657-6.08,8-11.303,8c-6.627,0-12-5.373-12-12c0-6.627,5.373-12,12-12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4C12.955,4,4,12.955,4,24c0,11.045,8.955,20,20,20c11.045,0,20-8.955,20-20C44,22.659,43.862,21.35,43.611,20.083z"/>
                                    <path fill="#FF3D00" d="M6.306,14.691l6.571,4.819C14.655,15.108,18.961,12,24,12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4C16.318,4,9.656,8.337,6.306,14.691z"/>
                                    <path fill="#4CAF50" d="M24,44c5.166,0,9.86-1.977,13.409-5.192l-6.19-5.238C29.211,35.091,26.715,36,24,36c-5.202,0-9.619-3.317-11.283-7.946l-6.522,5.025C9.505,39.556,16.227,44,24,44z"/>
                                    <path fill="#1976D2" d="M43.611,20.083H42V20H24v8h11.303c-0.792,2.237-2.231,4.166-4.087,5.571l6.19,5.238C43.196,35.21,44,29.704,44,24C44,22.659,43.862,21.35,43.611,20.083z"/>
                                </svg> Google
                            </a>
                            <a asp-controller="Account" asp-action="LoginFacebook" class="btn btn-social btn-facebook">
                                <i class="fab fa-facebook-f"></i> Facebook
                            </a>
                        </div>

                        <div class="text-center mt-5">
                            <p class="text-muted small mb-3">Chưa có tài khoản?</p>
                            <a href="/Account/Register" class="btn btn-register-outline w-100 hvr-sweep-to-right">Đăng ký thành viên</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- End -->
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}