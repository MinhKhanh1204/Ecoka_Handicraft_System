@using MVCApplication.Models.DTOs
@{
    ViewData["Title"] = "Detail";
}
@model ProductDetailResponseDto

@section Styles {
    <style>
        :root {
            --primary-green: #81c408;
            --dark-green: #6ea807;
            --soft-bg: #f8f9fa;
            --text-main: #2d3436;
            --text-muted: #636e72;
        }

        .product-detail-premium {
            background-color: #fff;
            color: var(--text-main);
            font-family: 'Inter', sans-serif;
        }

        /* Hero Header Matching */
        .page-header {
            background: linear-gradient(rgba(0,0,0,0.3), rgba(0,0,0,0.3)), url('/sliders/banner.png');
            background-size: cover;
            background-position: center;
            padding: 90px 0 60px !important;
            margin-bottom: 60px;
        }
        .page-header h1 {
            font-family: 'Raleway', sans-serif;
            font-weight: 800;
            color: #fff;
        }

        /* Product Gallery Resizing */
        .gallery-container {
            position: sticky;
            top: 120px;
            padding: 0 40px; /* More padding to make it smaller */
        }
        .main-img-wrapper {
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 15px 35px rgba(0,0,0,0.06);
            background: #fff;
            max-width: 480px; /* Limit size */
            margin: 0 auto;
            transition: transform 0.4s ease;
        }
        .main-img-wrapper:hover {
            transform: scale(1.02);
        }
        .main-img-wrapper img {
            width: 100%;
            height: auto;
            display: block;
        }

        /* Product Info */
        .product-info-premium {
            padding-left: 30px;
        }
        .category-badge {
            display: inline-block;
            padding: 6px 16px;
            background: rgba(129, 196, 8, 0.1);
            color: var(--primary-green);
            border-radius: 50px;
            font-size: 0.85rem;
            font-weight: 600;
            margin-bottom: 15px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        .product-title {
            font-size: 2.8rem;
            font-weight: 800;
            line-height: 1.2;
            margin-bottom: 20px;
            color: #1a1a1a;
        }
        .rating-summary {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 25px;
        }
        .rating-summary i {
            font-size: 0.9rem;
            color: #e2e8f0;
        }
        .rating-summary i.text-warning {
            color: #fbbf24 !important;
        }

        /* Price Section */
        .price-section {
            margin-bottom: 35px;
            padding-bottom: 25px;
            border-bottom: 1px solid #f1f3f5;
        }
        .current-price {
            font-size: 2.2rem;
            font-weight: 700;
            color: var(--primary-green);
        }
        .old-price {
            font-size: 1.2rem;
            color: var(--text-muted);
            text-decoration: line-through;
            margin-left: 15px;
        }

        /* Buy Box */
        .buy-box-premium {
            background: var(--soft-bg);
            padding: 30px;
            border-radius: 20px;
            margin-bottom: 30px;
        }
        .qty-selector {
            display: flex;
            align-items: center;
            background: #fff;
            border-radius: 12px;
            border: 1px solid #e9ecef;
            padding: 5px;
            width: fit-content;
        }
        .qty-btn {
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: none;
            background: transparent;
            color: var(--text-main);
            font-size: 1.2rem;
            transition: all 0.2s;
            border-radius: 8px;
        }
        .qty-btn:hover {
            background: #f8f9fa;
            color: var(--primary-green);
        }
        .qty-input {
            width: 60px;
            border: none;
            text-align: center;
            font-weight: 600;
            font-size: 1.1rem;
            background: transparent;
        }
        .btn-add-cart-premium {
            flex: 1;
            background: var(--primary-green);
            color: #fff;
            border: none;
            border-radius: 12px;
            padding: 0 30px;
            height: 52px;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            transition: all 0.3s;
            box-shadow: 0 10px 20px rgba(129, 196, 8, 0.2);
        }
        .btn-add-cart-premium:hover {
            background: var(--dark-green);
            transform: translateY(-2px);
            box-shadow: 0 15px 30px rgba(129, 196, 8, 0.3);
            color: #fff;
        }

        /* Tabs */
        .tabs-premium {
            border: none;
            gap: 40px;
            margin-bottom: 40px !important;
        }
        .tabs-premium .nav-link {
            border: none;
            background: none;
            padding: 0 0 10px;
            font-weight: 700;
            color: var(--text-muted);
            position: relative;
            font-size: 1.1rem;
        }
        .tabs-premium .nav-link.active {
            color: var(--text-main);
        }
        .tabs-premium .nav-link.active::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 3px;
            background: var(--primary-green);
            border-radius: 3px;
        }

        /* feedback list */
        .feedback-item {
            padding: 30px;
            border-radius: 20px;
            background: #fff;
            border: 1px solid #f1f3f5;
            margin-bottom: 20px;
            transition: transform 0.3s ease;
        }
        .feedback-item:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        }
        .feedback-avatar {
            width: 50px;
            height: 50px;
            background: #e9ecef;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            color: var(--primary-green);
            font-size: 1.2rem;
        }
        
        .feedback-form-premium {
            background: var(--soft-bg);
            padding: 40px;
            border-radius: 24px;
            margin-top: 60px;
        }

        @@media (max-width: 991px) {
            .product-info-premium { padding-left: 0; margin-top: 40px; }
            .product-title { font-size: 2rem; }
        }
    </style>
}

<div class="product-detail-premium">
    <!-- Header -->
    <div class="container-fluid page-header">
        <div class="container text-center">
            <h1 class="display-6 mb-3">Thông tin sản phẩm</h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb justify-content-center mb-0">
                    <li class="breadcrumb-item"><a href="/Home">Trang chủ</a></li>
                    <li class="breadcrumb-item"><a href="/Shop">Cửa hàng</a></li>
                    <li class="breadcrumb-item active text-white">@Model.ProductName</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="container py-5">
        <div class="row g-5">
            <!-- Left: Gallery -->
            <div class="col-lg-6">
                <div class="gallery-container">
                    <div class="main-img-wrapper">
                        <img src="@Model.MainImage" alt="@Model.ProductName" class="img-fluid" />
                    </div>
                </div>
            </div>

            <!-- Right: Info -->
            <div class="col-lg-6">
                <div class="product-info-premium">
                    <span class="category-badge">@Model.Category.CategoryName</span>
                    <h1 class="product-title">@Model.ProductName</h1>
                    
                    <div class="rating-summary" id="avg-rating">
                        <div class="stars d-flex gap-1">
                            <i class="fa fa-star"></i>
                            <i class="fa fa-star"></i>
                            <i class="fa fa-star"></i>
                            <i class="fa fa-star"></i>
                            <i class="fa fa-star"></i>
                        </div>
                        <span class="text-muted small" id="review-count">(0 đánh giá)</span>
                    </div>

                    <div class="price-section">
                        <div class="d-flex align-items-center">
                            <span class="current-price">@Model.FinalPrice.ToString("N0")<small class="fs-6 ms-1">VND</small></span>
                            @if (Model.Price != Model.FinalPrice)
                            {
                                <span class="old-price">@Model.Price.ToString("N0")</span>
                            }
                        </div>
                        <div class="mt-2">
                             <span class="badge @(Model.StockQuantity > 0 ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger") border border-success-subtle px-3">
                                <i class="fas fa-box-open me-1"></i>
                                Còn <span id="stockLabel">@Model.StockQuantity</span> sản phẩm
                            </span>
                        </div>
                    </div>

                    <p class="text-muted lh-lg mb-4">
                        @Model.Description
                    </p>

                    <div class="buy-box-premium">
                        <div class="d-flex flex-wrap gap-3 align-items-center">
                            <div class="qty-selector">
                                <button class="qty-btn" type="button" id="btnQtyMinus"><i class="fas fa-minus small"></i></button>
                                <input type="text" id="inputQty" class="qty-input" value="1" readonly />
                                <button class="qty-btn" type="button" id="btnQtyPlus"><i class="fas fa-plus small"></i></button>
                            </div>
                            
                            <button id="btnAddToCart"
                                    data-productid="@Model.ProductId"
                                    data-stock="@Model.StockQuantity"
                                    class="btn-add-cart-premium">
                                <i class="fas fa-shopping-basket"></i> Thêm vào giỏ hàng
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Bottom: Tabs & Reviews -->
            <div class="col-lg-12 pt-5">
                <nav>
                    <div class="nav nav-tabs tabs-premium" id="productTab" role="tablist">
                        <button class="nav-link active" id="about-tab" data-bs-toggle="tab" data-bs-target="#nav-about" type="button" role="tab">Mô tả chi tiết</button>
                        <button class="nav-link" id="reviews-tab" data-bs-toggle="tab" data-bs-target="#nav-reviews" type="button" role="tab">Đánh giá khách hàng <span id="tab-review-count">(0)</span></button>
                    </div>
                </nav>

                <div class="tab-content pt-4" id="nav-tabContent">
                    <!-- Description -->
                    <div class="tab-pane fade show active" id="nav-about" role="tabpanel">
                        <div class="lh-lg text-muted">
                            @Model.Description
                        </div>
                    </div>

                    <!-- Reviews -->
                    <div class="tab-pane fade" id="nav-reviews" role="tabpanel">
                        <div class="d-flex justify-content-between align-items-center mb-5">
                            <h4 class="fw-bold mb-0">Cảm nhận từ khách hàng</h4>
                            <div class="d-flex gap-2">
                                <select id="filterRating" class="form-select form-select-sm border-0 bg-light px-3" style="border-radius: 10px; width: 160px;">
                                    <option value="">Tất cả sao</option>
                                    <option value="5">Excellent (5★)</option>
                                    <option value="4">Great (4+★)</option>
                                    <option value="3">Good (3+★)</option>
                                </select>
                                <button class="btn btn-dark btn-sm px-4" style="border-radius: 10px;" onclick="filterFeedbacks()">Lọc</button>
                            </div>
                        </div>

                        <div id="feedback-list">
                            <div class="text-center py-5">
                                <div class="spinner-grow text-success" role="status"></div>
                            </div>
                        </div>

                        <!-- Feedback Form -->
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <div class="feedback-form-premium">
                                <h4 class="fw-bold mb-4">Chia sẻ trải nghiệm của bạn</h4>
                                <div class="row g-4">
                                    <div class="col-12">
                                        <div id="star-rating" class="d-flex gap-2 mb-3" style="cursor:pointer; font-size: 24px;">
                                            <i class="far fa-star text-muted" data-value="1"></i>
                                            <i class="far fa-star text-muted" data-value="2"></i>
                                            <i class="far fa-star text-muted" data-value="3"></i>
                                            <i class="far fa-star text-muted" data-value="4"></i>
                                            <i class="far fa-star text-muted" data-value="5"></i>
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <textarea id="feedbackComment" class="form-control border-0 p-4" rows="5" placeholder="Bạn cảm thấy sản phẩm này thế nào? Chia sẻ cùng Ecoka nhé..." style="border-radius: 20px;"></textarea>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-bold small text-muted mb-2">Đính kèm hình ảnh thực tế</label>
                                        <input type="file" id="feedbackImages" class="form-control" multiple accept="image/*" onchange="previewImages()" style="border-radius: 12px;">
                                        <div id="imagePreview" class="d-flex flex-wrap gap-2 mt-3"></div>
                                    </div>
                                    <div class="col-12 text-end">
                                        <button id="btnSubmitFeedback" class="btn btn-dark btn-lg px-5 py-3" style="border-radius: 16px; font-weight: 700;">Gửi đánh giá <i class="fas fa-paper-plane ms-2"></i></button>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="alert bg-light border-0 text-center p-5 mt-5" style="border-radius: 24px;">
                                <i class="fas fa-lock text-muted mb-3 d-block fs-1"></i>
                                <p class="text-muted mb-4">Vui lòng đăng nhập để có thể để lại đánh giá về sản phẩm.</p>
                                <a href="/Account/Login" class="btn btn-primary px-5 py-2 fw-bold" style="border-radius: 12px;">Đăng nhập ngay</a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Single Product End -->
@section Scripts {
    <script>
        // ==== CART ====
        const productId = '@Model.ProductId';
        const currentUserId = '@(ViewBag.CurrentUserId ?? string.Empty)';
        const stockQty = parseInt('@Model.StockQuantity') || 0;

        // Nút − / +
        $('#btnQtyMinus').click(function () {
            const input = $('#inputQty');
            const val = parseInt(input.val()) || 1;
            if (val > 1) input.val(val - 1);
        });

        $('#btnQtyPlus').click(function () {
            const input = $('#inputQty');
            const val = parseInt(input.val()) || 1;
            if (val < stockQty) input.val(val + 1);
            else input.val(stockQty);
        });

        // Validation khi nhập tay
        $('#inputQty').on('input change', function () {
            let val = parseInt($(this).val());
            if (isNaN(val) || val < 1) val = 1;
            if (val > stockQty) val = stockQty;
            $(this).val(val);
        });

        // Add to Cart
        $('#btnAddToCart').click(function () {
            // Lấy quantity hiện tại
            let qty = parseInt($('#inputQty').val());

            // Validation
            if (isNaN(qty) || qty < 1) {
                toastr.warning('Số lượng phải ít nhất là 1.');
                $('#inputQty').val(1).focus();
                return;
            }
            if (qty > stockQty) {
                toastr.warning(`Số lượng không được vượt quá tồn kho (${stockQty}).`);
                $('#inputQty').val(stockQty).focus();
                return;
            }

            // Check Login trước khi gửi
            if (!currentUserId) {
                toastr.info('Vui lòng đăng nhập để thêm sản phẩm vào giỏ hàng.');
                setTimeout(() => {
                    window.location.href = '/Account/Login?ReturnUrl=' + encodeURIComponent(window.location.pathname);
                }, 1500);
                return;
            }

            const btn = $(this);
            btn.prop('disabled', true).text('Đang thêm...');

            $.ajax({
                url: '/Cart/AddItem',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ ProductId: productId, Quantity: qty }),
                success: function () {
                    toastr.success(`Đã thêm ${qty} sản phẩm vào giỏ hàng!`);
                    
                    // Reset trạng thái nút thay vì chuyển trang
                    btn.prop('disabled', false).html('<i class="fa fa-cart-plus me-1"></i> Thêm vào giỏ hàng');
                    
                    // Reset ô input về 1 (tuỳ chọn)
                    $('#inputQty').val(1);
                },
                error: function (xhr) {
                    if (xhr.status === 401) {
                        window.location.href = '/Account/Login';
                    } else {
                        toastr.error('Thêm vào giỏ hàng thất bại!\n' + (xhr.responseText || ''));
                    }
                    btn.prop('disabled', false).html('<i class="fa fa-cart-plus me-1"></i> Thêm vào giỏ hàng');
                }
            });
        });

        // ==== FEEDBACK giữ nguyên như cũ, đồng bộ property ====
        let selectedRating = 0;
        let editingId = null;

        async function loadFeedbacks(minRating = null) {
            let url = `/Feedback/GetByProduct?productId=${productId}`;
            if (minRating) url += `&minRating=${minRating}`;
            try {
                const res = await fetch(url);
                const feedbacks = await res.json();
                renderFeedbacks(feedbacks);
                updateAverage(feedbacks);
            }
            catch {
                document.getElementById('feedback-list').innerHTML =
                    '<p class="text-danger">Không thể tải đánh giá.</p>';
            }
        }

        function renderFeedbacks(feedbacks) {
            if (!feedbacks.length) {
                document.getElementById('feedback-list').innerHTML =
                    '<div class="text-center py-5 opacity-50"><i class="fas fa-comment-slash fs-1 d-block mb-3"></i> Chưa có đánh giá nào cho sản phẩm này.</div>';
                return;
            }
            let html = '';
            feedbacks.forEach(fb => {
                const date = new Date(fb.createdAt).toLocaleDateString('vi-VN', { year:'numeric', month:'long', day:'numeric'});
                let stars = '';
                for (let i = 1; i <= 5; i++) {
                    stars += `<i class="fa fa-star ${i <= fb.rating ? 'text-warning' : 'text-muted opacity-25'}" style="font-size: 0.8rem;"></i>`;
                }
                let imagesHtml = '';
                if (fb.imageUrls && fb.imageUrls.length > 0) {
                    imagesHtml = '<div class="d-flex flex-wrap gap-2 mt-3">';
                    fb.imageUrls.forEach(url => {
                        imagesHtml += `<img src="${url}" class="rounded shadow-sm" style="width: 80px; height: 80px; object-fit: cover; cursor: pointer; transition: transform 0.2s;" onmouseover="this.style.transform='scale(1.05)'" onmouseout="this.style.transform='scale(1)'" onclick="window.open('${url}', '_blank')">`;
                    });
                    imagesHtml += '</div>';
                }

                html += `
                <div class="feedback-item">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="feedback-avatar text-uppercase">${(fb.username || fb.customerID || '?').substring(0,1)}</div>
                            <div>
                                <h6 class="fw-bold mb-0">${fb.username || fb.customerID}</h6>
                                <small class="text-muted" style="font-size: 0.75rem;">${date}</small>
                            </div>
                        </div>
                        <div class="d-flex gap-1">${stars}</div>
                    </div>
                    <p class="mb-0 text-muted lh-base">${fb.comment || ''}</p>
                    ${imagesHtml}
                    <div class="mt-3 text-end">
                        ${fb.customerID == currentUserId ? `
                            <button class="btn btn-link text-warning p-0 me-3 text-decoration-none small fw-bold"
                                onclick="editFeedback(${fb.feedbackID}, ${fb.rating}, \`${fb.comment || ''}\`)"><i class="fas fa-edit me-1"></i>Sửa</button>
                            <button class="btn btn-link text-danger p-0 text-decoration-none small fw-bold"
                                onclick="deleteFeedback(${fb.feedbackID})"><i class="fas fa-trash-alt me-1"></i>Xóa</button>
                        ` : ''}
                    </div>
                </div>`;
            });
            document.getElementById('feedback-list').innerHTML = html;
        }

        function updateAverage(feedbacks) {
            const avg = feedbacks.length
                ? feedbacks.reduce((s, f) => s + f.rating, 0) / feedbacks.length
                : 0;
            document.querySelectorAll('#avg-rating .fa-star')
                .forEach((star, idx) => {
                    star.classList.toggle('text-warning',
                        idx < Math.round(avg));
                });
            document.getElementById('review-count')
                .textContent = `(${feedbacks.length} đánh giá)`;
            document.getElementById('tab-review-count')
                .textContent = `(${feedbacks.length})`;
        }

        function filterFeedbacks() {
            const rating =
                document.getElementById('filterRating').value;
            loadFeedbacks(rating);
        }

        async function deleteFeedback(id) {
            if (!confirm("Xóa đánh giá này?")) return;
            try {
                const res = await fetch(`/Feedback/Delete/${id}`, {
                    method: 'DELETE'
                });
                if(res.ok) {
                    toastr.success("Xóa đánh giá thành công.");
                    loadFeedbacks();
                } else {
                    toastr.error("Xóa đánh giá thất bại.");
                }
            } catch (e) {
                toastr.error("Err: " + e.message);
            }
        }

        function editFeedback(id, rating, comment) {
            editingId = id;
            selectedRating = rating;
            document.getElementById('feedbackComment').value = comment;
            document.querySelectorAll('#star-rating i')
                .forEach((s, idx) => {
                    if (idx < rating) {
                        s.classList.remove('far', 'text-muted');
                        s.classList.add('fas', 'text-warning');
                    } else {
                        s.classList.remove('fas', 'text-warning');
                        s.classList.add('far', 'text-muted');
                    }
                });
            window.scrollTo({
                top: document.body.scrollHeight,
                behavior: 'smooth'
            });
        }

        document.querySelectorAll('#star-rating i')
            .forEach(star => {
                star.addEventListener('click', function () {
                    selectedRating =
                        parseInt(this.dataset.value);
                    document.querySelectorAll('#star-rating i')
                        .forEach((s, idx) => {
                            if (idx < selectedRating) {
                                s.classList.remove('far', 'text-muted');
                                s.classList.add('fas', 'text-warning');
                            } else {
                                s.classList.remove('fas', 'text-warning');
                                s.classList.add('far', 'text-muted');
                            }
                        });
                });
            });

        function previewImages() {
            const preview = document.getElementById('imagePreview');
            preview.innerHTML = '';
            const files = document.getElementById('feedbackImages').files;

            for (let i = 0; i < files.length; i++) {
                const file = files[i];
                const reader = new FileReader();
                reader.onload = function(e) {
                    const img = document.createElement('img');
                    img.src = e.target.result;
                    img.className = 'img-thumbnail';
                    img.style.width = '80px';
                    img.style.height = '80px';
                    img.style.objectFit = 'cover';
                    preview.appendChild(img);
                }
                reader.readAsDataURL(file);
            }
        }

        document.getElementById('btnSubmitFeedback')
            .addEventListener('click', async function () {
                const btn = $(this);
                const comment =
                    document.getElementById('feedbackComment')
                        .value.trim();

                // Custom Validations
                if (!selectedRating) {
                    toastr.warning('Qúy khách vui lòng chọn số sao (Rating).');
                    return;
                }
                
                if (comment.length < 10) {
                    toastr.warning('Bình luận quá ngắn. Vui lòng nhập tối thiểu 10 ký tự để tụi mình hiểu rõ hơn ý kiến của bạn.');
                    return;
                }

                // Cấm từ thô tục cơ bản (có thể mở rộng thêm)
                const badWords = ["dm", "vcl", "cc", "đm", "địt", "lồn", "cặc", "chó"];
                const lowerComment = comment.toLowerCase();
                const hasBadWord = badWords.some(word => {
                    const regex = new RegExp(`\\b${word}\\b`, 'g');
                    return regex.test(lowerComment);
                });

                if (hasBadWord) {
                    toastr.error('Bình luận của bạn chứa từ ngữ không phù hợp. Vui lòng dùng từ ngữ lịch sự nhé!');
                    return;
                }

                btn.prop('disabled', true).text('Đang gửi...');

                const formData = new FormData();
                formData.append('ProductID', productId);
                formData.append('Rating', selectedRating);
                formData.append('Comment', comment);

                const files = document.getElementById('feedbackImages').files;
                const maxSize = 10 * 1024 * 1024; // 10MB limit for Cloudinary free plan
                for (let i = 0; i < files.length; i++) {
                    if (files[i].size > maxSize) {
                        toastr.warning(`Ảnh "${files[i].name}" quá lớn (${(files[i].size / 1024 / 1024).toFixed(2)}MB). Vui lòng chọn ảnh dưới 10MB.`);
                        btn.prop('disabled', false).text('Đăng bình luận');
                        return;
                    }
                    formData.append('Images', files[i]);
                }

                try {
                    if (editingId) {
                        const res = await fetch(`/Feedback/Update/${editingId}`, {
                            method: 'PUT',
                            body: formData
                        });
                        const data = await res.json();
                        if (!res.ok || !data.success) {
                            throw new Error(data.message || 'Lỗi khi cập nhật feedback');
                        }
                        editingId = null;
                    } else {
                        const res = await fetch('/Feedback/Create', {
                            method: 'POST',
                            body: formData
                        });
                        const data = await res.json();
                        if (!res.ok || !data.success) {
                            throw new Error(data.message || 'Lỗi khi gửi feedback');
                        }
                    }

                    document.getElementById('feedbackComment').value = '';
                    document.getElementById('feedbackImages').value = '';
                    document.getElementById('imagePreview').innerHTML = '';
                    selectedRating = 0;
                    document.querySelectorAll('#star-rating i')
                        .forEach(s => {
                            s.classList.remove('fas', 'text-warning');
                            s.classList.add('far', 'text-muted');
                        });
                    loadFeedbacks();
                    toastr.success('Phản hồi của bạn đã được đăng thành công!');
                } catch (e) {
                    toastr.error('Lỗi: ' + e.message);
                } finally {
                    btn.prop('disabled', false).text('Đăng bình luận');
                }
            });

        // LOAD PAGE
        loadFeedbacks();
    </script>
}