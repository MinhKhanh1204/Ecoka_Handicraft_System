@using MVCApplication.CustomFormatter
@model PagedResult<ProductDto>
<div class="row g-4 justify-content-center">
	@foreach (var item in Model.Items)
	{
		<div class="col-md-6 col-lg-6 col-xl-4">
			<div class="border border-secondary rounded position-relative fruite-item">
				<div class="fruite-img">
					<img src="@item.MainImage" class="img-fluid w-100 rounded-top" alt="">
				</div>
				<div class="text-white bg-secondary px-3 py-1 rounded position-absolute" style="top: 10px; left: 10px;">@item.CategoryName</div>
				<div class="p-4 rounded-bottom">
                    <a href="/Shop/Detail/@item.ProductID"><h4>@item.ProductName</h4></a>
					@* <p>Lorem ipsum dolor sit amet consectetur adipisicing elit sed do eiusmod te incididunt</p> *@
					<div>
						<div class="d-flex justify-content-between flex-lg-wrap">
							<del>
								@if (item.OriginalPrice != item.FinalPrice)
								{
									@item.OriginalPrice.ToString("N0")
								}
							</del>

							<p class="text-dark fs-5 fw-bold mb-0">@item.FinalPrice.ToString("N0") VND</p>
						</div>
						<div>
							<a href="#" class="btn border border-secondary rounded-pill px-3 text-primary" style="width:100%"><i class="fa fa-shopping-bag me-2 text-primary"></i> Thêm vào giỏ hàng</a>
						</div>
					</div>
				</div>
			</div>
		</div>
	}
    <div class="col-12">
        <div class="pagination d-flex justify-content-center mt-5">

            <!-- Previous -->
            @if (Model.HasPreviousPage)
            {
                <a href="javascript:void(0)" onclick="loadProducts(@(Model.PageNumber - 1))" class="rounded">&laquo;</a>
            }
            else
            {
                <a class="rounded disabled">&laquo;</a>
            }

            <!-- Page numbers -->
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                if (i == Model.PageNumber)
                {
                    <a class="active rounded">@i</a>
                }
                else
                {
                    <a href="javascript:void(0)" onclick="loadProducts(@i)" class="rounded">@i</a>
                }
            }

            <!-- Next -->
            @if (Model.HasNextPage)
            {
                <a href="javascript:void(0)" onclick="loadProducts(@(Model.PageNumber + 1))" class="rounded">&raquo;</a>
            }
            else
            {
                <a class="rounded disabled">&raquo;</a>
            }

        </div>
    </div>
</div>