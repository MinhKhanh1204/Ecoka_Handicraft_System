@{
	ViewData["Title"] = "Cửa hàng";
}
@model ProductSearchViewModel
<!-- Single Page Header start -->
<div class="container-fluid page-header py-5">
	<h1 class="text-center text-white display-6">Cửa hàng</h1>
	<ol class="breadcrumb justify-content-center mb-0">
		<li class="breadcrumb-item"><a href="/Home">Trang chủ</a></li>
		<li class="breadcrumb-item active text-white">Cửa hàng</li>
	</ol>
</div>
<!-- Single Page Header End -->
<!-- Fruits Shop Start-->
<div class="container-fluid fruite py-5">
	<div class="container py-5">
		<h1 class="mb-4">Ecoka Handicraft</h1>
		<div class="row g-4">
			<div class="col-lg-12">
				<div class="row g-4">
					<div class="col-xl-3">
						<div class="input-group w-100 mx-auto d-flex">
							<input type="hidden" id="categoryId" value="0" />
							<input type="search" id="txtSearch" oninput="loadProducts()" class="form-control p-3" placeholder="Từ khóa tìm kiếm" aria-describedby="search-icon-1">
							<span id="search-icon-1" class="input-group-text p-3"><i class="fa fa-search"></i></span>
						</div>
					</div>
					<div class="col-6"></div>
					<div class="col-xl-3">
@* 						<div class="bg-light ps-3 py-3 rounded d-flex justify-content-between mb-4">
							<label for="fruits">Default Sorting:</label>
							<select id="fruits" onchange="setSort(this.value)" name="fruitlist" class="border-0 form-select-sm bg-light me-3" form="fruitform">
								<option value="volvo">Nothing</option>
								<option value="saab">Price asc</option>
								<option value="opel">Price desc</option>
							</select>
						</div> *@
					</div>
				</div>
				<div class="row g-4">
					<div class="col-lg-3">
						<div class="row g-4">
							<div class="col-lg-12">
								<div class="mb-3">
									<h4>Danh mục</h4>
									<ul class="list-unstyled fruite-categorie">
										@foreach (var cate in Model.Categories)
										{
											<li>
												<div class="d-flex justify-content-between fruite-name">
													<a id="cate-@cate.CategoryID" href="javascript:void(0)" onclick="setCategory(@cate.CategoryID)" class="@(cate.CategoryID == Model.CategoryID ? "active" : "")">
														<i class="fas fa-hand-paper me-2"></i>@cate.CategoryName
													</a>
												</div>
											</li>
										}
									</ul>
								</div>
							</div>
@* 							<div class="col-lg-12">
								<div class="mb-3">
									<h4 class="mb-2">Price</h4>
									<input type="range" oninput="setPrice(this.value)" class="form-range w-100" id="rangeInput" name="rangeInput" min="0" max="500" value="0" oninput="amount.value=rangeInput.value">
									<output id="amount" name="amount" min-value="0" max-value="500" for="rangeInput">0</output>
								</div>
							</div> *@
							
						
						</div>
					</div>
					<div class="col-lg-9" id="product-list">
						@await Html.PartialAsync("_ProductListPartial", Model.Products)
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
<!-- Fruits Shop End-->
@section Scripts {
	<script>

		function setCategory(id) {
			$("#categoryId").val(id);
			// remove active cũ
			$(".fruite-categorie li a").removeClass("active");

			// add active mới
			$("#cate-" + id).addClass("active");
			loadProducts(1);
		}

		function loadProducts(page = 1) {

			var keyword = $("#txtSearch").val();
			var categoryId = $("#categoryId").val();

			$.ajax({
				url: "/Shop/GetProducts",
				type: "GET",
				data: {
					page: page,
					categoryId: categoryId,
					txtSearch: keyword
				},
				success: function (data) {
					$("#product-list").html(data);
				}
			});
		}

		$(document).ready(function () {
			loadProducts(1);
		});

	</script>
}
