@model MVCApplication.Models.DTOs.Order

@{
    string PaymentStatusVi(string? status) => (status ?? "").Trim().ToLower() switch
    {
        "paid" => "Đã thanh toán",
        "pending" => "Chờ thanh toán",
        "failed" => "Thất bại",
        "refunded" => "Đã hoàn tiền",
        _ => string.IsNullOrWhiteSpace(status) ? "-" : status
    };

    string ShippingStatusVi(string? status) => (status ?? "").Trim().ToLower() switch
    {
        "pending" => "Chờ xử lý",
        "approved" => "Đã xác nhận",
        "shipping" => "Đang giao hàng",
        "delivered" => "Đã giao hàng",
        "cancelled" => "Đã hủy",
        _ => string.IsNullOrWhiteSpace(status) ? "-" : status
    };
}

<div class="order-details-premium p-1">
    <!-- Header Section -->
    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <h6 class="text-uppercase text-muted fw-bold small mb-2">Thông tin đơn hàng</h6>
            <h4 class="fw-bold mb-1">Mã đơn: #@Model.OrderID</h4>
            <p class="text-muted small mb-0">Ngày đặt: @Model.OrderDate?.ToString("dd/MM/yyyy HH:mm")</p>
        </div>
        <div class="col-md-6 text-md-end d-flex flex-column align-items-md-end gap-2">
            <div>
                <span class="badge @(Model.PaymentStatus == "Paid" ? "bg-success" : "bg-warning text-dark") rounded-pill px-3 py-2 shadow-sm">
                    <i class="fas fa-credit-card me-1"></i> @PaymentStatusVi(Model.PaymentStatus)
                </span>
            </div>
            <div>
                <span class="badge @(Model.ShippingStatus == "Pending" ? "bg-warning text-dark" : "bg-dark") rounded-pill px-3 py-2 shadow-sm">
                    <i class="fas fa-truck me-1"></i> @ShippingStatusVi(Model.ShippingStatus)
                </span>
            </div>
        </div>
    </div>

    <!-- Info Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card border-0 bg-light rounded-4 h-100 shadow-sm border-start border-4 border-primary">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center mb-2">
                        <i class="fas fa-map-marker-alt text-primary me-2"></i>
                        <h6 class="fw-bold mb-0 small text-uppercase">Địa chỉ giao hàng</h6>
                    </div>
                    <p class="text-muted small mb-0">@Model.ShippingAddress</p>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border-0 bg-light rounded-4 h-100 shadow-sm border-start border-4 border-info">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center mb-2">
                        <i class="fas fa-wallet text-info me-2"></i>
                        <h6 class="fw-bold mb-0 small text-uppercase">Thanh toán & Ghi chú</h6>
                    </div>
                    <p class="text-muted small mb-1">PTTT: @Model.PaymentMethod</p>
                    <p class="text-muted small mb-0 font-italic">
                        @(string.IsNullOrEmpty(Model.Note) ? "Không có ghi chú" : Model.Note)
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Items Table -->
    <h6 class="text-uppercase text-muted fw-bold small mb-2 ps-1">Sản phẩm đã chọn</h6>
    <div class="table-responsive mb-4 rounded-4 shadow-sm border bg-white overflow-hidden">
        <table class="table align-middle border-0 mb-0">
            <thead class="bg-light">
                <tr class="small text-uppercase">
                    <th class="border-0 ps-3 py-3">Sản phẩm</th>
                    <th class="border-0 text-center py-3">Số lượng</th>
                    <th class="border-0 text-end pe-3 py-3">Thành tiền</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.OrderItems != null && Model.OrderItems.Any())
                {
                    foreach (var item in Model.OrderItems)
                    {
                        <tr>
                            <td class="ps-3 py-3 border-bottom border-light">
                                <div class="d-flex align-items-center">
                                    <div class="rounded-3 border overflow-hidden me-3 shadow-sm bg-white" style="width: 50px; height: 50px;">
                                        <img src="@(string.IsNullOrEmpty(item.ProductImage) ? "/img/no-image.png" : item.ProductImage)" 
                                             class="w-100 h-100 object-fit-cover" 
                                             alt="@item.ProductName">
                                    </div>
                                    <div>
                                        <div class="fw-bold small">@item.ProductName</div>
                                        <div class="text-muted" style="font-size: 0.7rem;">@item.UnitPrice?.ToString("N0") <small>VND/sp</small></div>
                                    </div>
                                </div>
                            </td>
                            <td class="text-center py-3 border-bottom border-light fw-bold small">
                                x @item.Quantity
                            </td>
                            <td class="text-end pe-3 py-3 border-bottom border-light fw-bold text-dark">
                                @((item.Quantity * item.UnitPrice)?.ToString("N0")) <small>VND</small>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" class="text-center py-5 text-muted">Không tìm thấy thông tin sản phẩm.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Footer Summary -->
    <div class="bg-dark text-white rounded-4 p-4 shadow">
        <div class="row align-items-center">
            <div class="col-7">
                <h6 class="mb-0 fw-bold">TỔNG CỘNG</h6>
                <p class="text-white-50" style="font-size: 0.7rem;">Đã bao gồm phí và thuế (nếu có)</p>
            </div>
            <div class="col-5 text-end">
                <h4 class="mb-0 fw-bold" style="color: #81c408;">@Model.TotalAmount?.ToString("N0") <span class="fs-6">VND</span></h4>
            </div>
        </div>
    </div>
</div>