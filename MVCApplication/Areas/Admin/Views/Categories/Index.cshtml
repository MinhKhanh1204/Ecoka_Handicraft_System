@using MVCApplication.Areas.Admin.DTOs
@model IReadOnlyList<ReadCategoryDto>

@{
    ViewData["Title"] = "Categories";
    var keyword = (string?)ViewBag.Keyword;
    var status = (string?)ViewBag.Status;
}

<div class="pagetitle">
    <h1>Categories</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item active">Categories</li>
        </ol>
    </nav>
</div>

<section class="section">
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center">
                        <h5 class="card-title mb-0">Categories Management</h5>
                        <a class="btn btn-primary" asp-area="Admin" asp-controller="Categories" asp-action="Create">
                            <i class="bi bi-plus-circle me-1"></i>Thêm mới
                        </a>
                    </div>

                    <form method="get" class="row g-2 align-items-end mt-2" id="searchForm">
                        <div class="col-md-5 col-lg-4">
                            <label class="form-label">Tìm kiếm</label>
                            <input name="keyword" value="@keyword" class="form-control" placeholder="Nhập từ khóa..." />
                        </div>
                        <div class="col-md-4 col-lg-3">
                            <label class="form-label">Trạng thái</label>
                            <select name="status" class="form-select">
                                @{
                                    var s = status ?? "All";
                                }
                                @if (s == "All")
                                {
                                    <option value="All" selected="selected">Tất cả</option>
                                }
                                else
                                {
                                    <option value="All">Tất cả</option>
                                }

                                @if (s == "Active")
                                {
                                    <option value="Active" selected="selected">Active</option>
                                }
                                else
                                {
                                    <option value="Active">Active</option>
                                }

                                @if (s == "Inactive")
                                {
                                    <option value="Inactive" selected="selected">Inactive</option>
                                }
                                else
                                {
                                    <option value="Inactive">Inactive</option>
                                }

                                @if (s == "Deleted")
                                {
                                    <option value="Deleted" selected="selected">Deleted</option>
                                }
                                else
                                {
                                    <option value="Deleted">Deleted</option>
                                }

                                @if (string.Equals(s, "Pending", StringComparison.OrdinalIgnoreCase))
                                {
                                    <option value="Pending" selected="selected">Pending</option>
                                }
                                else
                                {
                                    <option value="Pending">Pending</option>
                                }

                                @if (string.Equals(s, "Rejected", StringComparison.OrdinalIgnoreCase))
                                {
                                    <option value="Rejected" selected="selected">Rejected</option>
                                }
                                else
                                {
                                    <option value="Rejected">Rejected</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3 col-lg-5 d-flex gap-2">
                            <button class="btn btn-outline-primary" type="submit">
                                <i class="bi bi-search me-1"></i>Search
                            </button>
                            <a class="btn btn-outline-secondary" asp-area="Admin" asp-controller="Categories" asp-action="Index">
                                Reset
                            </a>
                        </div>
                    </form>

                    <!-- Category Table (Partial) -->
                    <partial name="_CategoryList" model="Model" />
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script>
        const connection = new signalR.HubConnectionBuilder()
            .withUrl('/category-hub')
            .withAutomaticReconnect()
            .build();

        connection.on("CategoryApprovalStatusChanged", function (data) {
            const rowId = 'category-row-' + data.categoryId;
            const row = document.getElementById(rowId);
            
            if (row) {
                // Update text and badge classes
                const statusCell = row.cells[3]; // The status cell is the 4th column (index 3)
                const badge = statusCell.querySelector('.status-badge');
                if (badge) {
                    badge.innerText = data.status;
                    badge.className = 'badge status-badge'; // reset
                    if (data.status === 'Active') {
                        badge.classList.add('bg-success');
                    } else if (data.status === 'Deleted') {
                        badge.classList.add('bg-danger');
                    } else if (data.status === 'Rejected') {
                        badge.classList.add('bg-warning', 'text-dark');
                    } else if (data.status === 'Pending') {
                        badge.classList.add('bg-info', 'text-dark');
                    } else {
                        badge.classList.add('bg-secondary');
                    }
                }

                // Update Action buttons visibility
                const actionsCell = row.cells[4]; // The actions cell is the 5th column
                const actionButtons = actionsCell.querySelector('.action-buttons');
                const statusText = actionsCell.querySelector('.status-text');
                
                if (data.status === 'Pending') {
                    if (actionButtons) actionButtons.style.display = 'none';
                    if (statusText) {
                        statusText.style.display = 'inline';
                        statusText.innerText = 'Chờ duyệt';
                        statusText.className = 'small status-text text-muted';
                    }
                } else if (data.status === 'Rejected') {
                    if (actionButtons) actionButtons.style.display = 'none';
                    if (statusText) {
                        statusText.style.display = 'inline';
                        statusText.innerText = 'Bị từ chối';
                        statusText.className = 'small status-text text-danger';
                    }
                } else {
                    if (actionButtons) actionButtons.style.display = 'block';
                    if (statusText) statusText.style.display = 'none';
                }
            }
        });

        connection.start()
            .then(() => console.log('SignalR connected for Category Updates'))
            .catch(err => console.error('SignalR connection error:', err));

        // AJAX cho tìm kiếm và lọc
        const searchForm = document.getElementById('searchForm');
        if (searchForm) {
            searchForm.addEventListener('submit', function (e) {
                e.preventDefault();
                loadCategories();
            });
            
            // Xóa nút reset link vì có thể làm load lại trang, thay đổi thành function clear data (tuỳ chọn)
            const resetBtn = searchForm.querySelector('.btn-outline-secondary');
            if (resetBtn) {
                resetBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    searchForm.reset();
                    searchForm.querySelector('input[name="keyword"]').value = '';
                    searchForm.querySelector('select[name="status"]').value = 'All';
                    loadCategories();
                });
            }
        }

        function loadCategories() {
            const formData = new FormData(searchForm);
            const params = new URLSearchParams(formData);
            fetch('/Admin/Categories?' + params.toString(), {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(res => res.text())
            .then(html => {
                const container = document.getElementById('table-container');
                if (container) {
                    container.outerHTML = html;
                }
            })
            .catch(err => console.error('Error loading categories:', err));
        }

        // AJAX cho thao tác xóa
        window.deleteCategory = function (id) {
            if (!confirm('Bạn có chắc muốn xóa category này?')) return;

            fetch('/Admin/Categories/Delete/' + id, {
                method: 'POST',
                headers: { 
                    'X-Requested-With': 'XMLHttpRequest',
                    'Content-Type': 'application/x-www-form-urlencoded' 
                }
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    // Xóa thành công, reload table bằng Ajax
                    loadCategories();
                } else {
                    alert(data.message || 'Xóa thất bại');
                }
            })
            .catch(err => console.error('Delete error:', err));
        };
    </script>
}

