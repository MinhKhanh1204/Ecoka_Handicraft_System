@model MVCApplication.Areas.Admin.DTOs.StaffDetailViewModel

@{
    ViewData["Title"] = "Chi tiết nhân viên";
}

<div class="pagetitle">
    <h1>Chi tiết nhân viên</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Trang chủ</a>
            </li>
            <li class="breadcrumb-item">
                <a asp-action="Index">Nhân viên</a>
            </li>
            <li class="breadcrumb-item active">Chi tiết</li>
        </ol>
    </nav>
</div>

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-lg-12">

            <div class="card shadow-sm mb-5">
                <div class="card-header">
                    <h3 class="card-title mb-0">Thông tin nhân viên</h3>
                </div>

                <div class="card-body">

                    <div class="row">

                        <!-- LEFT -->
                        <div class="col-md-4 border-end">

                            <div class="text-center">

                                @if (!string.IsNullOrEmpty(Model.Avatar))
                                {
                                    <img src="@Model.Avatar"
                                         class="rounded-circle shadow mb-3"
                                         style="width:140px;height:140px;object-fit:cover;">
                                }
                                else
                                {
                                    <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center mx-auto mb-3 shadow"
                                         style="width:140px;height:140px;">
                                        <i class="bi bi-person-fill text-white" style="font-size:3rem;"></i>
                                    </div>
                                }

                                <h4 class="mb-1">@Model.FullName</h4>
                                <p class="text-muted">@Model.Email</p>

                                <div class="mt-3">

                                    @if (Model.Role == "Admin")
                                    {
                                        <span class="badge bg-primary px-3 py-2">Quản trị</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info text-dark px-3 py-2">Nhân viên</span>
                                    }

                                    @if (Model.Status)
                                    {
                                        <span class="badge bg-success px-3 py-2 ms-1">Hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger px-3 py-2 ms-1">Đã xóa</span>
                                    }

                                </div>

                            </div>

                        </div>

                        <!-- RIGHT -->
                        <div class="col-md-8">

                            <div class="row g-3">

                                <div class="col-md-6">
                                    <label class="text-muted small">Mã nhân viên</label>
                                    <div class="fw-semibold">@Model.StaffId</div>
                                </div>

                                <div class="col-md-6">
                                    <label class="text-muted small">Số điện thoại</label>
                                    <div class="fw-semibold">@Model.Phone</div>
                                </div>

                                <div class="col-md-6">
                                    <label class="text-muted small">Giới tính</label>
                                    <div class="fw-semibold">@(Model.Gender ?? "Không có")</div>
                                </div>

                                <div class="col-md-6">
                                    <label class="text-muted small">Ngày sinh</label>
                                    <div class="fw-semibold">
                                        @(Model.DateOfBirth?.ToString("dd/MM/yyyy") ?? "Không có")
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <label class="text-muted small">CCCD</label>
                                    <div class="fw-semibold">@(Model.CitizenId ?? "Không có")</div>
                                </div>

                                <div class="col-md-6">
                                    <label class="text-muted small">Ngày vào làm</label>
                                    <div class="fw-semibold">@(Model.HireDate ?? "Không có")</div>
                                </div>

                                <div class="col-12">
                                    <label class="text-muted small">Địa chỉ</label>
                                    <div class="fw-semibold">@(Model.Address ?? "Không có")</div>
                                </div>

                            </div>

                        </div>

                    </div>

                </div>

                <!-- BUTTONS -->
                <div class="card-footer text-center">

                    <a asp-action="Edit"
                       asp-route-id="@Model.StaffId"
                       class="btn btn-warning me-2 ajax-link">
                        <i class="bi bi-pencil"></i> Chỉnh sửa
                    </a>

                    <a asp-action="Index"
                       class="btn btn-secondary ajax-link">
                        <i class="bi bi-arrow-left"></i> Quay lại
                    </a>

                </div>

            </div>

        </div>
    </div>
</div>