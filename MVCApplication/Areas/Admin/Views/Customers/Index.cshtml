@model IEnumerable<MVCApplication.Models.CustomerViewModel>

@{
    ViewData["Title"] = "Quản lý khách hàng";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    
    var currentPage = ViewBag.CurrentPage ?? 1;
    var totalPages = ViewBag.TotalPages ?? 1;
    var totalCustomers = ViewBag.TotalCustomers ?? 0;
    var pageSize = 10;
    var startItem = (currentPage - 1) * pageSize + 1;
    var endItem = Math.Min(currentPage * pageSize, totalCustomers);
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Quản lý khách hàng</h3>
                </div>
                <div class="card-body">
                    <!-- Search & Sort Form -->
                    <form method="get" asp-action="Index" class="mb-4">
                        <div class="row g-3">
                            <div class="col-md-3">
                                <input type="text" name="keyword" class="form-control" 
                                       placeholder="Tìm theo tên, tên đăng nhập, email, số điện thoại..." 
                                       value="@ViewBag.Keyword" 
                                       maxlength="100" />
                            </div>
                            <div class="col-md-2">
                                <select name="status" class="form-control">
                                    <option value="">Tất cả trạng thái</option>
                                    <option value="Active" selected="@(ViewBag.Status == "Active")">Hoạt động</option>
                                    <option value="Inactive" selected="@(ViewBag.Status == "Inactive")">Ngừng hoạt động</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <select name="sortBy" id="sortBy" class="form-control" onchange="this.form.submit()">
                                    <option value="id_asc" selected="@(ViewBag.SortBy != "id_desc")">ID: Tăng dần</option>
                                    <option value="id_desc" selected="@(ViewBag.SortBy == "id_desc")">ID: Giảm dần</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <button type="submit" class="btn btn-primary btn-block">
                                    <i class="bi bi-search"></i> Tìm kiếm
                                </button>
                            </div>
                            <div class="col-md-2">
                                <a asp-action="Index" class="btn btn-secondary btn-block">
                                    <i class="bi bi-arrow-counterclockwise"></i> Đặt lại
                                </a>
                            </div>
                        </div>
                    </form>

                    <!-- Customer Table -->
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover table-striped">
                            <thead class="table-dark">
                                <tr>
                                    <th>ID</th>
                                    <th>Tên đăng nhập</th>
                                    <th>Họ và tên</th>
                                    <th>Email</th>
                                    <th>Điện thoại</th>
                                    <th>Trạng thái</th>
                                    <th>Ngày tạo</th>
                                    <th>Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.Any())
                                {
                                    <tr>
                                        <td colspan="8" class="text-center text-muted py-4">
                                            <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                            Không có khách hàng nào.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    foreach (var customer in Model)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@customer.CustomerID</strong>
                                            </td>
                                            <td>@customer.Username</td>
                                            <td>@customer.FullName</td>
                                            <td>@customer.Email</td>
                                            <td>@customer.Phone</td>
                                            <td>
                                                @if (customer.Status == "Active")
                                                {
                                                    <span class="badge bg-success">Hoạt động</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">Ngừng hoạt động</span>
                                                }
                                            </td>
                                            <td>@customer.CreatedAt?.ToString("yyyy-MM-dd")</td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    <a asp-action="Details" asp-route-id="@customer.CustomerID" 
                                                       class="btn btn-info btn-sm" title="Chi tiết">
                                                        <i class="bi bi-eye"></i>
                                                    </a>
                                                    @if (customer.Status == "Active")
                                                    {
                                                        <form asp-action="UpdateStatus" asp-route-id="@customer.CustomerID" method="post" style="display:inline;">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="status" value="Inactive" />
                                                            <button type="submit" class="btn btn-secondary btn-sm" 
                                                                    title="Vô hiệu hóa"
                                                                    onclick="return confirm('Bạn có chắc muốn vô hiệu hóa khách hàng này?');">
                                                                <i class="bi bi-person-dash"></i>
                                                            </button>
                                                        </form>
                                                    }
                                                    else
                                                    {
                                                        <form asp-action="UpdateStatus" asp-route-id="@customer.CustomerID" method="post" style="display:inline;">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="status" value="Active" />
                                                            <button type="submit" class="btn btn-success btn-sm" 
                                                                    title="Kích hoạt"
                                                                    onclick="return confirm('Bạn có chắc muốn kích hoạt lại khách hàng này?');">
                                                                <i class="bi bi-person-check"></i>
                                                            </button>
                                                        </form>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    @if (totalPages > 1)
                    {
                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <div class="text-muted">
                                Hiển thị @startItem đến @endItem trong tổng @totalCustomers khách hàng
                            </div>
                            <nav>
                                <ul class="pagination mb-0">
                                    <!-- Previous -->
                                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                        <a class="page-link" href="@Url.Action("Index", new { 
                                            keyword = ViewBag.Keyword, 
                                            status = ViewBag.Status, 
                                            sortBy = ViewBag.SortBy, 
                                            page = currentPage - 1 
                                        })">Trước</a>
                                    </li>

                                    <!-- Page Numbers -->
                                    @for (int i = 1; i <= totalPages; i++)
                                    {
                                        <li class="page-item @(i == currentPage ? "active" : "")">
                                            <a class="page-link" href="@Url.Action("Index", new { 
                                                keyword = ViewBag.Keyword, 
                                                status = ViewBag.Status, 
                                                sortBy = ViewBag.SortBy, 
                                                page = i 
                                            })">@i</a>
                                        </li>
                                    }

                                    <!-- Next -->
                                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                        <a class="page-link" href="@Url.Action("Index", new { 
                                            keyword = ViewBag.Keyword, 
                                            status = ViewBag.Status, 
                                            sortBy = ViewBag.SortBy, 
                                            page = currentPage + 1 
                                        })">Sau</a>
                                    </li>
                                </ul>
                            </nav>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
