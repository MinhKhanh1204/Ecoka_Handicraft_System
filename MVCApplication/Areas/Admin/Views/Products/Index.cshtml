@using MVCApplication.Areas.Admin.DTOs
@using MVCApplication.CustomFormatter
@model PagedResult<ReadProductDto>

@{
    ViewData["Title"] = "Sản phẩm";
    var keyword = (string?)ViewBag.Keyword;
    var status = (string?)ViewBag.Status;

    bool isAdmin = User.IsInRole("Admin");
    bool isStaff = User.IsInRole("Staff");
    var isAjax = Context.Request.Headers["X-Requested-With"] == "XMLHttpRequest";
}

@if (!isAjax)
{
    @:<div id="product-ajax-container">
}

<div class="pagetitle">
    <h1>Sản phẩm</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Trang chủ</a>
            </li>
            <li class="breadcrumb-item active">Sản phẩm</li>
        </ol>
    </nav>
</div>

<section class="section">
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-body">

                    <!-- Header -->
                    <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-4">
                        <h5 class="card-title mb-0">Quản lý sản phẩm</h5>

                        <a class="btn btn-primary ajax-link"
                           asp-area="Admin"
                           asp-controller="Products"
                           asp-action="Create">
                            <i class="bi bi-plus-circle me-1"></i> Thêm mới
                        </a>
                    </div>

                    <!-- Search -->
                    <div class="mb-3">
                        <form method="get" class="row g-2 ajax-form">
                            <input type="hidden" name="status" value="@status" />
                            <div class="col-md-8 col-lg-6">
                                <div class="input-group">
                                    <input name="keyword"
                                           value="@keyword"
                                           class="form-control"
                                           placeholder="Tìm theo tên sản phẩm..." />
                                    <button class="btn btn-primary" type="submit">
                                        <i class="bi bi-search me-1"></i> Tìm kiếm
                                    </button>
                                </div>
                            </div>
                            <div class="col-md-4 col-lg-6">
                                <a class="btn btn-outline-secondary ajax-link"
                                   asp-area="Admin"
                                   asp-controller="Products"
                                   asp-action="Index">
                                    Reset tất cả
                                </a>
                            </div>
                        </form>
                    </div>

                    <!-- Filter -->
                    <div class="mb-4 p-3 bg-light rounded border">
                        <form method="get" class="row g-2 align-items-center ajax-form">
                            <input type="hidden" name="keyword" value="@keyword" />
                            <div class="col-auto">
                                <label class="fw-bold me-2">Lọc theo trạng thái:</label>
                            </div>
                            <div class="col-md-3">
                                <select name="status" class="form-select border-primary">
                                    <option value="All" selected="@(string.IsNullOrEmpty(status) || status == "All")">Tất cả</option>
                                    <option value="Active" selected="@(status == "Active")">Đang bán</option>
                                    <option value="Pending" selected="@(status == "Pending")">Chờ duyệt</option>
                                    <option value="Inactive" selected="@(status == "Inactive")">Không còn bán</option>
                                    @if (isAdmin)
                                    {
                                        <option value="Rejected" selected="@(status == "Rejected")">Bị từ chối</option>
                                    }
                                </select>
                            </div>
                        </form>
                    </div>

                    <!-- Table -->
                    <div class="table-responsive mt-3">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th style="width:60px;">STT.</th>
                                    <th>Ảnh</th>
                                    <th>Sản phẩm</th>
                                    <th>Loại</th>
                                    <th>Giá</th>
                                    <th>Kho</th>
                                    <th>Trạng thái</th>
                                    <th class="text-end">Hành động</th>
                                </tr>
                            </thead>

                            <tbody>
                                @if (Model.Items == null || !Model.Items.Any())
                                {
                                    <tr>
                                        <td colspan="8" class="text-center text-muted py-5">
                                            <i class="bi bi-box-seam display-4 d-block mb-3"></i>
                                            Không tìm thấy sản phẩm
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    int stt = (Model.PageNumber - 1) * Model.PageSize;

                                    foreach (var p in Model.Items)
                                    {
                                        stt++;

                                        string badgeClass = p.Status switch
                                        {
                                            "Active" => "success",
                                            "Pending" => "warning text-dark",
                                            "Rejected" => "danger",
                                            "Inactive" => "secondary",
                                            _ => "dark"
                                        };

                                        <tr>
                                            <td class="fw-bold">@stt</td>

                                            <td>
                                                <img src="@(string.IsNullOrEmpty(p.MainImage) ? "/images/no-image.png" : p.MainImage)"
                                                     alt="@p.ProductName"
                                                     style="width:55px;height:55px;object-fit:cover"
                                                     class="rounded shadow-sm border" />
                                            </td>

                                            <td>@p.ProductName</td>

                                            <td>
                                                <span class="badge bg-light text-dark border">
                                                    @p.CategoryName
                                                </span>
                                            </td>

                                            <td class="text-danger fw-bold">
                                                @p.Price.ToString("C0", new System.Globalization.CultureInfo("vi-VN"))
                                            </td>

                                            <td>
                                                @if (p.StockQuantity <= 5)
                                                {
                                                    <span class="text-danger fw-bold">
                                                        <i class="bi bi-exclamation-triangle-fill"></i> @p.StockQuantity
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span>@p.StockQuantity</span>
                                                }
                                            </td>

                                            <td>
                                                @{
                                                    var statusVi = p.Status switch
                                                    {
                                                        "Active" => "Đang bán",
                                                        "Pending" => "Chờ duyệt",
                                                        "Rejected" => "Từ chối",
                                                        "Inactive" => "Ngừng bán",
                                                        _ => p.Status
                                                    };
                                                }
                                                <span class="badge bg-@badgeClass">@statusVi</span>
                                            </td>

                                            <td class="text-end">
                                                <div class="btn-group shadow-sm">

                                                    <a class="btn btn-sm btn-outline-secondary ajax-link"
                                                       asp-action="Details"
                                                       asp-route-id="@p.ProductID">
                                                        <i class="bi bi-eye"></i>
                                                    </a>

                                                    @if (p.Status != "Pending" && p.Status != "Rejected")
                                                    {
                                                        <a class="btn btn-sm btn-outline-primary ajax-link"
                                                           asp-action="Edit"
                                                           asp-route-id="@p.ProductID">
                                                            <i class="bi bi-pencil"></i>
                                                        </a>
                                                    }

                                                    @if (isAdmin && p.Status == "Pending")
                                                    {
                                                        <form asp-action="Approve" asp-route-id="@p.ProductID" method="post" class="d-inline ajax-post-form">
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit" class="btn btn-sm btn-success">
                                                                <i class="bi bi-check-circle"></i>
                                                            </button>
                                                        </form>

                                                        <form asp-action="Reject" asp-route-id="@p.ProductID" method="post" class="d-inline ajax-post-form">
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit" class="btn btn-sm btn-danger">
                                                                <i class="bi bi-x-circle"></i>
                                                            </button>
                                                        </form>
                                                    }

                                                    @* Delete button now visible for both Admin and Staff *@
                                                    @if (p.Status != "Inactive" && p.Status != "Pending" && p.Status != "Rejected")
                                                    {
                                                        <form asp-action="Delete"
                                                              asp-route-id="@p.ProductID"
                                                              method="post"
                                                              class="d-inline ajax-delete-form"
                                                              data-confirm="Ngừng bán sản phẩm này?">
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                                <i class="bi bi-trash"></i>
                                                            </button>
                                                        </form>
                                                    }

                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    @if (Model.TotalPages > 1)
                    {
                        <nav class="mt-4">
                            <ul class="pagination justify-content-center">

                                <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                                    <a class="page-link ajax-link"
                                       asp-action="Index"
                                       asp-route-pageNumber="@(Model.PageNumber - 1)"
                                       asp-route-keyword="@keyword"
                                       asp-route-status="@status">
                                        <i class="bi bi-chevron-left"></i>
                                    </a>
                                </li>

                                @for (int i = 1; i <= Model.TotalPages; i++)
                                {
                                    <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                        <a class="page-link ajax-link"
                                           asp-action="Index"
                                           asp-route-pageNumber="@i"
                                           asp-route-keyword="@keyword"
                                           asp-route-status="@status">
                                            @i
                                        </a>
                                    </li>
                                }

                                <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                                    <a class="page-link ajax-link"
                                       asp-action="Index"
                                       asp-route-pageNumber="@(Model.PageNumber + 1)"
                                       asp-route-keyword="@keyword"
                                       asp-route-status="@status">
                                        <i class="bi bi-chevron-right"></i>
                                    </a>
                                </li>

                            </ul>
                        </nav>
                    }

                </div>
            </div>
        </div>
    </div>
</section>

@if (!isAjax)
{
    @:</div>

    @section Scripts {
        <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                var container = document.getElementById('product-ajax-container');
                if (!container) return; // Fallback in case container is missing

                // Handle changes to selects inside forms (like the status filter) or radio buttons
                container.addEventListener('change', function(e) {
                    if (e.target.tagName === 'SELECT' && e.target.form && e.target.form.classList.contains('ajax-form')) {
                        e.target.form.dispatchEvent(new Event('submit', { cancelable: true, bubbles: true }));
                    }
                    if (e.target.name === 'mainImageIndex') {
                        var index = parseInt(e.target.value);
                        var hiddens = container.querySelectorAll('input[type="hidden"][name^="Images["][name$="].IsMain"]');
                        hiddens.forEach((hidden, hIndex) => {
                            hidden.value = (hIndex === index).toString().toLowerCase();
                        });
                    }
                });

                // Handle click events (Pagination, Links)
                container.addEventListener('click', function(e) {
                    var link = e.target.closest('a.ajax-link');
                    if (link) {
                        e.preventDefault();
                        var url = link.getAttribute('href');
                        if (url && url !== '#') {
                            loadAjaxContent(url);
                        }
                    }
                });

                // Handle form submissions
                container.addEventListener('submit', function(e) {
                    var form = e.target.closest('form');
                    if (!form) return;

                    if (form.classList.contains('ajax-form')) {
                        e.preventDefault();
                        var method = (form.getAttribute('method') || 'GET').toUpperCase();
                        var url = form.getAttribute('action') || (method === 'GET' ? window.location.pathname : window.location.href);
                        var formData = new FormData(form);

                        if (method === 'GET') {
                            var params = new URLSearchParams(formData).toString();
                            var separator = url.indexOf('?') !== -1 ? '&' : '?';
                            loadAjaxContent(url + separator + params);
                        } else {
                            submitAjaxForm(form);
                        }
                    } else if (form.classList.contains('ajax-post-form')) {
                        e.preventDefault();
                        submitAjaxForm(form);
                    } else if (form.classList.contains('ajax-delete-form')) {
                        e.preventDefault();
                        var msg = form.getAttribute('data-confirm') || 'Bạn có chắc không?';
                        if (!confirm(msg)) {
                            return;
                        }
                        submitAjaxForm(form, true);
                    }
                });

                function loadAjaxContent(url) {
                    fetch(url, {
                        method: 'GET',
                        headers: { "X-Requested-With": "XMLHttpRequest" }
                    })
                    .then(function(response) {
                        if (!response.ok) throw new Error('Network response was ' + response.statusText);
                        return response.text();
                    })
                    .then(function(html) {
                        container.innerHTML = html;
                        window.history.pushState({ path: url }, '', url);
                    })
                    .catch(function(error) {
                        if (typeof showToast === 'function') {
                            showToast('Không tải được nội dung. Vui lòng thử lại.', 'error');
                        } else {
                            alert('Không tải được nội dung. Vui lòng thử lại.');
                        }
                        console.error('Error:', error);
                    });
                }

                function submitAjaxForm(formElement, isDelete = false) {
                    var url = formElement.getAttribute('action');
                    var method = formElement.getAttribute('method') || 'POST';
                    var formData = new FormData(formElement);

                    fetch(url, {
                        method: method,
                        body: formData,
                        headers: { "X-Requested-With": "XMLHttpRequest" }
                    })
                    .then(function(response) {
                        const contentType = response.headers.get("content-type");
                        if (contentType && contentType.indexOf("application/json") !== -1) {
                            return response.json().then(data => ({ type: 'json', data: data }));
                        } else {
                            // If the response is a redirect or HTML, fetch handles it cleanly.
                            // But usually, ASP.NET Core returns redirects. With AJAX fetch, we might get an opaque response or HTML of the new page.
                            // Since we configured the JSON return in the controller for valid paths, HTML means an error occurred and the form needs to be re-displayed.
                            return response.text().then(text => ({ type: 'html', data: text }));
                        }
                    })
                    .then(function(result) {
                        if (result.type === 'json') {
                            // JSON response => Success or JSON error
                            var data = result.data;
                            if (data.success) {
                                if (typeof showToast === 'function') {
                                    showToast(data.message || 'Thao tác thành công', 'success');
                                }
                                loadAjaxContent('@Url.Action("Index", "Products", new { area = "Admin" })');
                            } else {
                                if (typeof showToast === 'function') {
                                    showToast(data.message || 'Đã có lỗi xảy ra', 'error');
                                }
                            }
                        } else {
                            // HTML response => Validation errors
                            container.innerHTML = result.data;
                            // Note: Vanilla MVC unobtrusive validation doesn't easily re-parse without jQuery.
                            // However, server validation messages are already embedded in the HTML.
                        }
                    })
                    .catch(function(error) {
                        if (typeof showToast === 'function') {
                            showToast('Gửi biểu mẫu thất bại. Vui lòng thử lại.', 'error');
                        } else {
                            alert('Gửi biểu mẫu thất bại. Vui lòng thử lại.');
                        }
                        console.error('Error:', error);
                    });
                }

                // Handle browser back/forward buttons seamlessly via AJAX
                window.addEventListener('popstate', function(e) {
                    var state = e.state;
                    if (state && state.path) {
                        fetch(state.path, {
                            method: 'GET',
                            headers: { "X-Requested-With": "XMLHttpRequest" }
                        })
                        .then(response => response.text())
                        .then(html => {
                            container.innerHTML = html;
                        });
                    } else {
                        window.location.reload();
                    }
                });

                const approvalConnection = new signalR.HubConnectionBuilder()
    .withUrl("/pending-approval-hub")
    .withAutomaticReconnect()
    .build();

approvalConnection.on("ProductApproved", function (data) {
    if (typeof showToast === 'function') {
        showToast('Đã duyệt sản phẩm', 'success');
    }

    var listUrl = '@Url.Action("Index", "Products", new { area = "Admin" })';
    var currentSearch = window.location.search;
    loadAjaxContent(listUrl + currentSearch);
});

approvalConnection.on("ProductRejected", function (data) { 
    if (typeof showToast === 'function') {
        showToast('Đã từ chối sản phẩm', 'warning');
    }

    var listUrl = '@Url.Action("Index", "Products", new { area = "Admin" })';
    var currentSearch = window.location.search;
    loadAjaxContent(listUrl + currentSearch);
});

approvalConnection.start().catch(function (err) {
    console.error("SignalR PendingApprovalHub error: " + err.toString());
});
            });
        </script>
    }
}