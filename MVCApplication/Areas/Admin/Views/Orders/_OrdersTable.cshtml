@model IEnumerable<MVCApplication.Models.DTOs.Order>

<div class="card shadow-sm">
    <div class="card-body">

        <table class="table table-hover table-bordered align-middle">

            <thead class="table-dark">
                <tr>
                    <th>Mã đơn</th>
                    <th>Khách hàng</th>
                    <th>Ngày đặt</th>
                    <th class="text-end">Tổng tiền</th>
                    <th>Thanh toán</th>
                    <th>Vận chuyển</th>
                    <th class="text-center" style="width:220px">Thao tác</th>
                </tr>
            </thead>

            <tbody>

                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted">
                            Không tìm thấy đơn hàng
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var o in Model)
                    {
                        <tr>

                            <td><strong>@o.OrderID</strong></td>

                            <td>@(string.IsNullOrWhiteSpace(o.CustomerID) ? "-" : o.CustomerID)</td>

                            <td>@(o.OrderDate?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td>

                            <td class="text-end">
                                @((o.TotalAmount ?? 0).ToString("C"))
                            </td>

                            <td>
                                <span class="badge bg-success">
                                    @(o.PaymentStatus switch
                                    {
                                        "Pending" => "Chưa thanh toán",
                                        "Paid" => "Đã thanh toán",
                                        "Refunded" => "Hoàn tiền",
                                        _ => "-"
                                    })
                        </span>
                    </td>

                            <td>
                                <span class="badge bg-info text-dark">
                                    @(o.ShippingStatus switch
                                    {
                                        "Pending" => "Chờ xử lý",
                                        "Shipping" => "Đang giao",
                                        "Completed" => "Hoàn thành",
                                        "Cancelled" => "Đã hủy",
                                        _ => "-"
                                    })
                        </span>
                    </td>

                            <td class="text-center">

                                <a class="btn btn-sm btn-info"
                                   href="/Admin/Orders/Details/@o.OrderID">
                                    Chi tiết
                                </a>

                                <form method="post"
                                      action="/Admin/Orders/UpdateStatus"
                                      class="d-inline">

                                    <input type="hidden" name="orderId" value="@o.OrderID" />

                                    <select name="newStatus"
                                            class="form-select form-select-sm d-inline w-auto">

                                        <option value="Pending">Chờ xử lý</option>
                                        <option value="Shipping">Đang giao</option>
                                        <option value="Completed">Hoàn thành</option>

                                    </select>

                                    <button class="btn btn-warning btn-sm">
                                        Cập nhật
                                    </button>

                                </form>

                            </td>

                        </tr>
                                }
                }

            </tbody>
        </table>

    </div>
</div>

<!-- PHÂN TRANG -->

<nav class="mt-3">
    <ul class="pagination justify-content-center">

        @for (int i = 1; i <= ViewBag.TotalPages; i++)
        {
            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">

                <a class="page-link page-btn"
                   data-page="@i">
                    @i
                </a>

            </li>
        }

    </ul>
</nav>