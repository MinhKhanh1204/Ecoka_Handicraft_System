@model MVCApplication.Models.DTOs.Order

<div class="row mb-3">

    <div class="col-md-6">
        <strong>Mã đơn hàng:</strong> @Model.OrderID <br />
        <strong>Khách hàng:</strong> @(Model.CustomerID ?? "-") <br />
        <strong>Ngày đặt:</strong> @(Model.OrderDate?.ToString("yyyy-MM-dd HH:mm") ?? "-")
    </div>

    <div class="col-md-6">
        <strong>Phương thức thanh toán:</strong> @(Model.PaymentMethod ?? "-") <br />
        <strong>Trạng thái thanh toán:</strong>
        @(Model.PaymentStatus switch
        {
            "Pending" => "Chưa thanh toán",
            "Paid" => "Đã thanh toán",
            "Refunded" => "Hoàn tiền",
            _ => "-"
        }) <br />
        <strong>Trạng thái vận chuyển:</strong>
        @(Model.ShippingStatus switch
        {
            "Pending" => "Chờ xử lý",
            "Shipping" => "Đang giao",
            "Completed" => "Hoàn thành",
            "Cancelled" => "Đã hủy",
            _ => "-"
        })
    </div>

</div>

<div class="table-responsive">
    <table class="table table-bordered">
        <thead class="table-light">
            <tr>
                <th>Sản phẩm</th>
                <th>Số lượng</th>
                <th class="text-end">Đơn giá</th>
                <th class="text-end">Thành tiền</th>
            </tr>
        </thead>
        <tbody>

            @if (Model.OrderItems != null && Model.OrderItems.Any())
            {
                foreach (var it in Model.OrderItems)
                {
                    <tr>
                        <td>@(it.ProductName ?? it.ProductID)</td>
                        <td>@it.Quantity</td>
                        <td class="text-end">@((it.UnitPrice ?? 0).ToString("C"))</td>
                        <td class="text-end">@(((it.UnitPrice ?? 0) * (it.Quantity ?? 0)).ToString("C"))</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-center">Không có sản phẩm</td>
                </tr>
            }

        </tbody>
    </table>
</div>