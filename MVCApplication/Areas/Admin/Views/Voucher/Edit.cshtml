@using MVCApplication.Areas.Admin.DTOs
@model UpdateVoucherDto

@{
    ViewData["Title"] = "Sửa voucher";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var voucherId = ViewBag.VoucherId as int? ?? 0;
}

<div class="pagetitle">
    <h1>Sửa voucher</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Quản lý voucher</a></li>
            <li class="breadcrumb-item active">Sửa #@voucherId</li>
        </ol>
    </nav>
</div>

<section class="section">
    <div class="row">
        <div class="col-lg-10 mx-auto">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Sửa voucher #@voucherId</h5>

                    <form asp-action="Edit" asp-route-id="@voucherId" method="post" class="row g-3">
                        <div asp-validation-summary="ModelOnly" class="text-danger col-12"></div>

                        <div class="col-md-6">
                            <label asp-for="VoucherName" class="form-label">Tên voucher <span class="text-danger">*</span></label>
                            <input asp-for="VoucherName" class="form-control" />
                            <span asp-validation-for="VoucherName" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Mã</label>
                            <input type="text" class="form-control" value="(Không sửa được)" disabled />
                            <small class="text-muted">Mã không đổi sau khi tạo.</small>
                        </div>

                        <div class="col-12">
                            <label asp-for="Description" class="form-label">Mô tả</label>
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="DiscountPercentage" class="form-label">Giảm giá % <span class="text-danger">*</span></label>
                            <input asp-for="DiscountPercentage" type="number" class="form-control" min="0.01" max="50" step="0.01" />
                            <div class="form-text">Từ 0,01% đến 50%</div>
                            <span asp-validation-for="DiscountPercentage" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="MaxReducing" class="form-label">Giảm tối đa (VNĐ)</label>
                            <input asp-for="MaxReducing" type="number" class="form-control" min="0" step="1000" />
                            <span asp-validation-for="MaxReducing" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Quantity" class="form-label">Số lượng <span class="text-danger">*</span></label>
                            <input asp-for="Quantity" type="number" class="form-control" min="0" />
                            <span asp-validation-for="Quantity" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="ExpiryDate" class="form-label">Ngày hết hạn <span class="text-danger">*</span></label>
                            <input asp-for="ExpiryDate" type="date" class="form-control" />
                            <span asp-validation-for="ExpiryDate" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="MinOrderValue" class="form-label">Đơn tối thiểu (VNĐ)</label>
                            <input asp-for="MinOrderValue" type="number" class="form-control" min="0" step="1000" />
                        </div>

                        <div class="col-md-4">
                            <label asp-for="MaxUsagePerUser" class="form-label">Lượt dùng tối đa / người</label>
                            <input asp-for="MaxUsagePerUser" type="number" class="form-control" min="1" />
                        </div>

                        <div class="col-12 mt-4">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save me-1"></i> Lưu thay đổi
                            </button>
                            <a asp-action="Details" asp-route-id="@voucherId" class="btn btn-info">Xem chi tiết</a>
                            <a asp-action="Index" class="btn btn-secondary">Hủy</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
