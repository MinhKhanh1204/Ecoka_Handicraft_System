@using MVCApplication.Areas.Admin.DTOs
@using MVCApplication.CustomFormatter
@model PagedResult<VoucherListDto>

@{
    ViewData["Title"] = "Quản lý voucher";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var keyword = ViewBag.Keyword as string;
    var status = ViewBag.Status as string;
    var sortBy = ViewBag.SortBy as string ?? "id_asc";
}

<div class="pagetitle">
    <h1>Quản lý voucher</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item active">Quản lý voucher</li>
        </ol>
    </nav>
</div>

<section class="section">
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-4">
                        <h5 class="card-title mb-0">Danh sách voucher</h5>
                        <a class="btn btn-primary" asp-action="Create">
                            <i class="bi bi-plus-circle me-1"></i> Thêm voucher
                        </a>
                    </div>

                    <form method="get" class="mb-4" id="voucherSearchForm">
                        <div class="row g-3">
                            <div class="col-md-3">
                                <input type="text" name="keyword" class="form-control"
                                       placeholder="Tìm theo tên, mã, giảm giá..."
                                       value="@keyword" />
                            </div>
                            <div class="col-md-2">
                                <select name="status" class="form-select" onchange="this.form.submit()">
                                    <option value="">Tất cả trạng thái</option>
                                    <option value="Active" selected="@(status == "Active")">Đang dùng</option>
                                    <option value="Inactive" selected="@(status == "Inactive")">Ngừng dùng</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <select name="sortBy" class="form-select" onchange="this.form.submit()">
                                    <option value="id_asc" selected="@(sortBy == "id_asc")">ID: Tăng dần</option>
                                    <option value="id_desc" selected="@(sortBy == "id_desc")">ID: Giảm dần</option>
                                    <option value="name_asc" selected="@(sortBy == "name_asc")">Tên: A-Z</option>
                                    <option value="name_desc" selected="@(sortBy == "name_desc")">Tên: Z-A</option>
                                    <option value="expiry_asc" selected="@(sortBy == "expiry_asc")">Hết hạn: Sớm nhất</option>
                                    <option value="expiry_desc" selected="@(sortBy == "expiry_desc")">Hết hạn: Muộn nhất</option>
                                    <option value="discount_desc" selected="@(sortBy == "discount_desc")">Giảm giá: Cao</option>
                                    <option value="discount_asc" selected="@(sortBy == "discount_asc")">Giảm giá: Thấp</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <button type="submit" class="btn btn-primary w-100">
                                    <i class="bi bi-search me-1"></i> Tìm kiếm
                                </button>
                            </div>
                            <div class="col-md-2">
                                <a asp-action="Index" class="btn btn-outline-secondary w-100">Đặt lại</a>
                            </div>
                        </div>
                    </form>

                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>ID</th>
                                    <th>Tên</th>
                                    <th>Mã</th>
                                    <th>Giảm %</th>
                                    <th>Giảm tối đa</th>
                                    <th>Số lượng</th>
                                    <th>Hết hạn</th>
                                    <th>Trạng thái</th>
                                    <th class="text-end">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Items == null || !Model.Items.Any())
                                {
                                    <tr>
                                        <td colspan="9" class="text-center text-muted py-5">
                                            <i class="bi bi-ticket-perforated display-4 d-block mb-3"></i>
                                            Không có voucher nào.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    foreach (var v in Model.Items)
                                    {
                                        <tr id="voucher-row-@v.VoucherId">
                                            <td><strong>@v.VoucherId</strong></td>
                                            <td>@v.VoucherName</td>
                                            <td><code>@v.Code</code></td>
                                            <td>@(v.DiscountPercentage?.ToString("0.#") ?? "-")%</td>
                                            <td>@(v.MaxReducing.HasValue? v.MaxReducing.Value.ToString("N0") : "-")</td>
                                            <td>@v.Quantity</td>
                                            <td>@v.ExpiryDate?.ToString("yyyy-MM-dd")</td>
                                            <td>
                                                @if (v.IsActive == true)
                                                {
                                                    <span class="badge bg-success status-badge">Đang dùng</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary status-badge">Ngừng dùng</span>
                                                }
                                            </td>
                                            <td class="text-end">
                                                <div class="btn-group">
                                                    <a asp-action="Details" asp-route-id="@v.VoucherId" class="btn btn-sm btn-outline-info" title="Xem">
                                                        <i class="bi bi-eye"></i>
                                                    </a>
                                                    <a asp-action="Edit" asp-route-id="@v.VoucherId" class="btn btn-sm btn-outline-primary" title="Sửa">
                                                        <i class="bi bi-pencil"></i>
                                                    </a>
                                                    <form asp-action="Delete" asp-route-id="@v.VoucherId" method="post" class="d-inline"
                                                          onsubmit="return confirm('Bạn có chắc muốn xóa voucher này?');">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>

                    @if (Model.TotalPages > 1)
                    {
                        <nav class="mt-4">
                            <ul class="pagination justify-content-center">
                                <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                                    <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.PageNumber - 1)"
                                       asp-route-keyword="@keyword" asp-route-status="@status" asp-route-sortBy="@sortBy">
                                        <i class="bi bi-chevron-left"></i>
                                    </a>
                                </li>
                                @for (int i = 1; i <= Model.TotalPages; i++)
                                {
                                    <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                        <a class="page-link" asp-action="Index" asp-route-pageNumber="@i"
                                           asp-route-keyword="@keyword" asp-route-status="@status" asp-route-sortBy="@sortBy">@i</a>
                                    </li>
                                }
                                <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                                    <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.PageNumber + 1)"
                                       asp-route-keyword="@keyword" asp-route-status="@status" asp-route-sortBy="@sortBy">
                                        <i class="bi bi-chevron-right"></i>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                        <p class="text-muted small text-center">
                            Hiển thị @((Model.PageNumber - 1) * Model.PageSize + 1)–@Math.Min(Model.PageNumber * Model.PageSize, Model.TotalCount) / @Model.TotalCount voucher
                        </p>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script>
        const voucherConnection = new signalR.HubConnectionBuilder()
            .withUrl('/voucher-hub')
            .withAutomaticReconnect()
            .build();

        function reloadVoucherPage() {
            window.location.reload();
        }

        function updateVoucherRowStatus(voucherId, status) {
            const row = document.getElementById('voucher-row-' + voucherId);
            if (!row) {
                reloadVoucherPage();
                return;
            }

            const statusCell = row.cells[7];
            if (!statusCell) {
                reloadVoucherPage();
                return;
            }

            let badge = statusCell.querySelector('.status-badge');
            if (!badge) {
                badge = document.createElement('span');
                badge.className = 'badge status-badge';
                statusCell.innerHTML = '';
                statusCell.appendChild(badge);
            }

            if (status === 'Active') {
                badge.textContent = 'Đang dùng';
                badge.className = 'badge bg-success status-badge';
            } else {
                badge.textContent = 'Ngừng dùng';
                badge.className = 'badge bg-secondary status-badge';
            }
        }

        voucherConnection.on("VoucherCreated", function (data) {
            console.log("VoucherCreated:", data);
            reloadVoucherPage();
        });

        voucherConnection.on("VoucherUpdated", function (data) {
            console.log("VoucherUpdated:", data);
            reloadVoucherPage();
        });

        voucherConnection.on("VoucherDeleted", function (data) {
            console.log("VoucherDeleted:", data);
            reloadVoucherPage();
        });

        voucherConnection.on("VoucherApprovalStatusChanged", function (data) {
            console.log("VoucherApprovalStatusChanged:", data);

            if (data.status === "Active") {
                updateVoucherRowStatus(data.voucherId, "Active");
            } else {
                updateVoucherRowStatus(data.voucherId, "Inactive");
            }

            reloadVoucherPage();
        });

        voucherConnection.start()
            .then(() => console.log('Connected to voucher-hub'))
            .catch(err => console.error('SignalR voucher-hub error:', err));
    </script>
}