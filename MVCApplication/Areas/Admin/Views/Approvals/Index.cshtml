@model MVCApplication.Areas.Admin.DTOs.ApprovalDto
@using System.Globalization

<div class="pagetitle">
    <h1>Approvals</h1>
</div>

<section class="section">
    <div class="card">
        <div class="card-body pt-3">

            <ul class="nav nav-tabs mb-3">
                <li class="nav-item">
                    <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#products">
                        Products (<span id="product-count">@Model.PendingProducts.TotalCount</span>)
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#categories">
                        Categories (<span id="category-count">@Model.PendingCategories.Count</span>)
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#vouchers">
                        Vouchers (<span id="voucher-count">@Model.PendingVouchers.Count</span>)
                    </button>
                </li>
            </ul>

            <div class="tab-content">
                <!-- PRODUCTS -->
                <div class="tab-pane fade show active" id="products">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Product ID</th>
                                    <th>Image</th>
                                    <th>Product</th>
                                    <th>Category</th>
                                    <th>Price</th>
                                    <th>Stock</th>
                                    <th>Status</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="productPendingBody">
                                @if (!Model.PendingProducts.Items.Any())
                                {
                                    <tr id="product-empty-row">
                                        <td colspan="9" class="text-center text-muted">No pending products</td>
                                    </tr>
                                }
                                else
                                {
                                    var index = 0;
                                    foreach (var p in Model.PendingProducts.Items)
                                    {
                                        index++;
                                        <tr id="product-row-@p.ProductID">
                                            <td>@index</td>
                                            <td>@p.ProductID</td>
                                            <td>
                                                <img src="@(string.IsNullOrEmpty(p.MainImage) ? "/images/no-image.png" : p.MainImage)"
                                                     width="55" height="55" style="object-fit:cover" class="rounded" />
                                            </td>
                                            <td>@p.ProductName</td>
                                            <td>@p.CategoryName</td>
                                            <td>@p.Price.ToString("C0", new CultureInfo("vi-VN"))</td>
                                            <td>@p.StockQuantity</td>
                                            <td>@p.Status</td>
                                            <td class="text-end">
                                                <button class="btn btn-sm btn-success"
                                                        onclick="approveProduct('@p.ProductID')">
                                                    Approve
                                                </button>
                                                <button class="btn btn-sm btn-danger"
                                                        onclick="rejectProduct('@p.ProductID')">
                                                    Reject
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- CATEGORIES -->
                <div class="tab-pane fade" id="categories">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Category ID</th>
                                    <th>Name</th>
                                    <th>Description</th>
                                    <th>Status</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="categoryPendingBody">
                                @if (!Model.PendingCategories.Any())
                                {
                                    <tr id="category-empty-row">
                                        <td colspan="6" class="text-center text-muted">No pending categories</td>
                                    </tr>
                                }
                                else
                                {
                                    var idx = 0;
                                    foreach (var c in Model.PendingCategories)
                                    {
                                        idx++;
                                        <tr id="category-row-@c.CategoryID">
                                            <td>@idx</td>
                                            <td>@c.CategoryID</td>
                                            <td>@c.CategoryName</td>
                                            <td>@c.Description</td>
                                            <td>@c.Status</td>
                                            <td class="text-end">
                                                <button class="btn btn-sm btn-success"
                                                        onclick="approveCategory(@c.CategoryID)">
                                                    Approve
                                                </button>
                                                <button class="btn btn-sm btn-danger"
                                                        onclick="rejectCategory(@c.CategoryID)">
                                                    Reject
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- VOUCHERS -->
                <div class="tab-pane fade" id="vouchers">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Voucher ID</th>
                                    <th>Name</th>
                                    <th>Code</th>
                                    <th>Discount</th>
                                    <th>Max Reducing</th>
                                    <th>Qty</th>
                                    <th>Expiry</th>
                                    <th>Active</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="voucherPendingBody">
                                @if (!Model.PendingVouchers.Any())
                                {
                                    <tr id="voucher-empty-row">
                                        <td colspan="10" class="text-center text-muted">No pending vouchers</td>
                                    </tr>
                                }
                                else
                                {
                                    var vi = 0;
                                    foreach (var v in Model.PendingVouchers)
                                    {
                                        vi++;
                                        <tr id="voucher-row-@v.VoucherId">
                                            <td>@vi</td>
                                            <td>@v.VoucherId</td>
                                            <td>@v.VoucherName</td>
                                            <td>@v.Code</td>
                                            <td>@(v.DiscountPercentage?.ToString("0.##") + "%")</td>
                                            <td>@(v.MaxReducing.HasValue ? v.MaxReducing.Value.ToString("C0", new CultureInfo("vi-VN")) : "-")</td>
                                            <td>@v.Quantity</td>
                                            <td>@(v.ExpiryDate.HasValue ? v.ExpiryDate.Value.ToString("yyyy-MM-dd") : "-")</td>
                                            <td>@(v.IsActive == true ? "Yes" : "No")</td>
                                            <td class="text-end">
                                                <button class="btn btn-sm btn-success"
                                                        onclick="approveVoucher(@v.VoucherId)">
                                                    Approve
                                                </button>
                                                <button class="btn btn-sm btn-danger"
                                                        onclick="rejectVoucher(@v.VoucherId)">
                                                    Reject
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="toast-container position-fixed top-0 end-0 p-3">
    <div id="liveToast" class="toast align-items-center text-bg-primary border-0" role="alert">
        <div class="d-flex">
            <div class="toast-body" id="toastMessage">Notification</div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto"
                    data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script>
        // Toast helpers
        function showToast(message, isSuccess = true) {
            const toastEl = document.getElementById('liveToast');
            const msgEl = document.getElementById('toastMessage');

            msgEl.innerText = message;
            toastEl.classList.remove('text-bg-success', 'text-bg-danger', 'text-bg-primary');
            toastEl.classList.add(isSuccess ? 'text-bg-success' : 'text-bg-danger');

            const toast = new bootstrap.Toast(toastEl);
            toast.show();
        }

        function updateCount(id, delta) {
            const el = document.getElementById(id);
            if (!el) return;
            const current = parseInt(el.innerText || '0');
            el.innerText = Math.max(0, current + delta);
        }

        function removeRow(rowId, countId) {
            const row = document.getElementById(rowId);
            if (row) {
                row.remove();
                updateCount(countId, -1);
            }
        }

        async function postAction(url, id, rowId, countId) {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            const formData = new FormData();
            formData.append("id", id);
            if (token) formData.append("__RequestVerificationToken", token);

            const response = await fetch(url, {
                method: "POST",
                body: formData
            });

            // Expect JSON { success: bool, message: string, id: ... }
            const result = await response.json();

            if (result.success) {
                removeRow(rowId, countId);
                showToast(result.message || "Success", true);
            } else {
                showToast(result.message || "Failed", false);
            }
        }

        // Product actions
        function approveProduct(id) {
            postAction('/Admin/Approvals/ApproveProduct', id, `product-row-${id}`, 'product-count');
        }
        function rejectProduct(id) {
            postAction('/Admin/Approvals/RejectProduct', id, `product-row-${id}`, 'product-count');
        }

        // Category actions
        function approveCategory(id) {
            postAction('/Admin/Approvals/ApproveCategory', id, `category-row-${id}`, 'category-count');
        }
        function rejectCategory(id) {
            postAction('/Admin/Approvals/RejectCategory', id, `category-row-${id}`, 'category-count');
        }

        // Voucher actions
        function approveVoucher(id) {
            postAction('/Admin/Approvals/ApproveVoucher', id, `voucher-row-${id}`, 'voucher-count');
        }
        function rejectVoucher(id) {
            postAction('/Admin/Approvals/RejectVoucher', id, `voucher-row-${id}`, 'voucher-count');
        }

        // UI row insertion helpers for SignalR events
        function addPendingProductRow(product) {
            const tbody = document.getElementById('productPendingBody');
            const emptyRow = document.getElementById('product-empty-row');
            if (emptyRow) emptyRow.remove();

            const pid = product.productID || product.ProductID;
            const img = product.mainImage || product.MainImage || '/images/no-image.png';
            const price = (product.price ?? product.Price) !== undefined ? (product.price ?? product.Price) : '';
            const stock = product.stockQuantity ?? product.StockQuantity ?? '';

            const row = document.createElement('tr');
            row.id = `product-row-${pid}`;
            row.innerHTML = `
                <td>New</td>
                <td>${pid}</td>
                <td><img src="${img}" width="55" height="55" style="object-fit:cover" class="rounded" /></td>
                <td>${product.productName || product.ProductName || ''}</td>
                <td>${product.categoryName || product.CategoryName || ''}</td>
                <td>${price}</td>
                <td>${stock}</td>
                <td>${product.status || ''}</td>
                <td class="text-end">
                    <button class="btn btn-sm btn-success" onclick="approveProduct('${pid}')">Approve</button>
                    <button class="btn btn-sm btn-danger" onclick="rejectProduct('${pid}')">Reject</button>
                </td>
            `;
            tbody.prepend(row);
            updateCount('product-count', 1);
            showToast('New pending product', true);
        }

        function addPendingCategoryRow(category) {
            const tbody = document.getElementById('categoryPendingBody');
            const emptyRow = document.getElementById('category-empty-row');
            if (emptyRow) emptyRow.remove();

            const id = category.categoryID ?? category.CategoryID;
            const row = document.createElement('tr');
            row.id = `category-row-${id}`;
            row.innerHTML = `
                <td>New</td>
                <td>${id}</td>
                <td>${category.categoryName || category.CategoryName || ''}</td>
                <td>${category.description || category.Description || ''}</td>
                <td>${category.status || category.Status || ''}</td>
                <td class="text-end">
                    <button class="btn btn-sm btn-success" onclick="approveCategory(${id})">Approve</button>
                    <button class="btn btn-sm btn-danger" onclick="rejectCategory(${id})">Reject</button>
                </td>
            `;
            tbody.prepend(row);
            updateCount('category-count', 1);
            showToast('New pending category', true);
        }

        function addPendingVoucherRow(voucher) {
            const tbody = document.getElementById('voucherPendingBody');
            const emptyRow = document.getElementById('voucher-empty-row');
            if (emptyRow) emptyRow.remove();

            const id = voucher.voucherId ?? voucher.VoucherId;
            const discount = voucher.discountPercentage ?? voucher.DiscountPercentage;
            const maxReducing = voucher.maxReducing ?? voucher.MaxReducing;
            const qty = voucher.quantity ?? voucher.Quantity;
            const expiry = voucher.expiryDate ?? voucher.ExpiryDate;
            const isActive = voucher.isActive ?? voucher.IsActive;

            const row = document.createElement('tr');
            row.id = `voucher-row-${id}`;
            row.innerHTML = `
                <td>New</td>
                <td>${id}</td>
                <td>${voucher.voucherName || voucher.VoucherName || ''}</td>
                <td>${voucher.code || voucher.Code || ''}</td>
                <td>${discount ? discount + '%' : '-'}</td>
                <td>${maxReducing ? maxReducing : '-'}</td>
                <td>${qty ?? '-'}</td>
                <td>${expiry ? expiry : '-'}</td>
                <td>${isActive ? 'Yes' : 'No'}</td>
                <td class="text-end">
                    <button class="btn btn-sm btn-success" onclick="approveVoucher(${id})">Approve</button>
                    <button class="btn btn-sm btn-danger" onclick="rejectVoucher(${id})">Reject</button>
                </td>
            `;
            tbody.prepend(row);
            updateCount('voucher-count', 1);
            showToast('New pending voucher', true);
        }

        // SignalR connection
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/pending-approval-hub")
            .withAutomaticReconnect()
            .build();

        connection.on("PendingProductCreated", function (product) {
            addPendingProductRow(product);
        });

        connection.on("PendingCategoryCreated", function (category) {
            addPendingCategoryRow(category);
        });

        connection.on("PendingVoucherCreated", function (voucher) {
            addPendingVoucherRow(voucher);
        });

        connection.start()
            .then(() => console.log("SignalR connected"))
            .catch(err => console.error(err));
    </script>

    @Html.AntiForgeryToken()
}