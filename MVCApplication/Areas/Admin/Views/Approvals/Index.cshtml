@model MVCApplication.Areas.Admin.DTOs.ApprovalDto
@using System.Globalization

@{
    ViewData["Title"] = "Duyệt nội dung";
    var viCulture = new CultureInfo("vi-VN");
}

<div class="pagetitle">
    <h1>Duyệt nội dung</h1>
</div>

<section class="section">
    <div class="card">
        <div class="card-body pt-3">

            <ul class="nav nav-tabs mb-3" id="approvalTabs" role="tablist">
                <li class="nav-item">
                    <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#products">
                        Sản phẩm (<span id="product-count">@Model.PendingProducts.Items.Count</span>)
                    </button>
                </li>

                <li class="nav-item">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#categories">
                        Danh mục (<span id="category-count">@Model.PendingCategories.Count</span>)
                    </button>
                </li>

                <li class="nav-item">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#vouchers">
                        Voucher (<span id="voucher-count">@Model.PendingVouchers.Count</span>)
                    </button>
                </li>
            </ul>

            <div class="tab-content">

                <!-- PRODUCTS -->
                <div class="tab-pane fade show active" id="products">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Mã SP</th>
                                <th>Ảnh</th>
                                <th>Tên sản phẩm</th>
                                <th>Danh mục</th>
                                <th>Giá</th>
                                <th>Tồn kho</th>
                                <th>Trạng thái</th>
                                <th class="text-end">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody id="productPendingBody">
                            @if (!Model.PendingProducts.Items.Any())
                            {
                                <tr id="product-empty-row">
                                    <td colspan="9" class="text-center text-muted">Không có sản phẩm chờ duyệt</td>
                                </tr>
                            }
                            else
                            {
                                var index = 0;
                                foreach (var p in Model.PendingProducts.Items)
                                {
                                    index++;
                                    <tr id="product-row-@p.ProductID">
                                        <td>@index</td>
                                        <td>@p.ProductID</td>
                                        <td>
                                            <img src="@(string.IsNullOrWhiteSpace(p.MainImage) ? "/images/no-image.png" : p.MainImage)"
                                                 width="55" height="55" class="rounded" style="object-fit:cover" />
                                        </td>
                                        <td>@p.ProductName</td>
                                        <td>@p.CategoryName</td>
                                        <td>@p.Price.ToString("C0", viCulture)</td>
                                        <td>@p.StockQuantity</td>
                                        <td>@p.Status</td>
                                        <td class="text-end">
                                            <button class="btn btn-sm btn-success" onclick="approveProduct('@p.ProductID')">Duyệt</button>
                                            <button class="btn btn-sm btn-danger" onclick="rejectProduct('@p.ProductID')">Từ chối</button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <!-- CATEGORIES -->
                <div class="tab-pane fade" id="categories">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Mã danh mục</th>
                                <th>Tên</th>
                                <th>Mô tả</th>
                                <th>Trạng thái</th>
                                <th class="text-end">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody id="categoryPendingBody">
                            @if (!Model.PendingCategories.Any())
                            {
                                <tr id="category-empty-row">
                                    <td colspan="6" class="text-center text-muted">Không có danh mục chờ duyệt</td>
                                </tr>
                            }
                            else
                            {
                                var index = 0;
                                foreach (var c in Model.PendingCategories)
                                {
                                    index++;
                                    <tr id="category-row-@c.CategoryID">
                                        <td>@index</td>
                                        <td>@c.CategoryID</td>
                                        <td>@c.CategoryName</td>
                                        <td>@c.Description</td>
                                        <td>@c.Status</td>
                                        <td class="text-end">
                                            <button class="btn btn-sm btn-success" onclick="approveCategory(@c.CategoryID)">Duyệt</button>
                                            <button class="btn btn-sm btn-danger" onclick="rejectCategory(@c.CategoryID)">Từ chối</button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <!-- VOUCHERS -->
                <div class="tab-pane fade" id="vouchers">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Mã voucher</th>
                                <th>Tên</th>
                                <th>Mã code</th>
                                <th>Giảm (%)</th>
                                <th>Giảm tối đa</th>
                                <th>Số lượng</th>
                                <th>Hạn</th>
                                <th>Kích hoạt</th>
                                <th class="text-end">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody id="voucherPendingBody">
                            @if (!Model.PendingVouchers.Any())
                            {
                                <tr id="voucher-empty-row">
                                    <td colspan="10" class="text-center text-muted">Không có voucher chờ duyệt</td>
                                </tr>
                            }
                            else
                            {
                                var index = 0;
                                foreach (var v in Model.PendingVouchers)
                                {
                                    index++;
                                    <tr id="voucher-row-@v.VoucherId">
                                        <td>@index</td>
                                        <td>@v.VoucherId</td>
                                        <td>@v.VoucherName</td>
                                        <td>@v.Code</td>
                                        <td>@(v.DiscountPercentage?.ToString("0.##") + "%" ?? "-")</td>
                                        <td>@(v.MaxReducing?.ToString("C0", viCulture) ?? "-")</td>
                                        <td>@v.Quantity</td>
                                        <td>@(v.ExpiryDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                                        <td>@(v?.IsActive == true ? "Có" : "Không")</td>
                                        <td class="text-end">
                                            <button class="btn btn-sm btn-success" onclick="approveVoucher(@v.VoucherId)">Duyệt</button>
                                            <button class="btn btn-sm btn-danger" onclick="rejectVoucher(@v.VoucherId)">Từ chối</button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

            </div>
        </div>
    </div>
</section>

<!-- Toast -->
<div class="toast-container position-fixed top-0 end-0 p-3">
    <div id="liveToast" class="toast text-bg-primary border-0">
        <div class="d-flex">
            <div class="toast-body" id="toastMessage">Thông báo</div>
            <button class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

<form id="antiForgeryForm" method="post" style="display:none;">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>

    <script>
        const pendingConnection = new signalR.HubConnectionBuilder()
            .withUrl("/pending-approval-hub")
            .withAutomaticReconnect()
            .build();

        function getAntiForgeryToken() {
            const tokenInput = document.querySelector('#antiForgeryForm input[name="__RequestVerificationToken"]');
            return tokenInput ? tokenInput.value : '';
        }

        function escapeHtml(value) {
            if (value === null || value === undefined) return '';
            return String(value)
                .replaceAll('&', '&amp;')
                .replaceAll('<', '&lt;')
                .replaceAll('>', '&gt;')
                .replaceAll('"', '&quot;')
                .replaceAll("'", '&#39;');
        }

        function formatMoney(value) {
            if (value === null || value === undefined || value === '') return '-';
            const number = Number(value);
            if (Number.isNaN(number)) return escapeHtml(value);
            return number.toLocaleString('vi-VN') + ' ₫';
        }

        function formatPercent(value) {
            if (value === null || value === undefined || value === '') return '-';
            return `${value}%`;
        }

        function formatDate(value) {
            if (!value) return '-';
            const date = new Date(value);
            if (isNaN(date.getTime())) return escapeHtml(value);
            return date.toISOString().slice(0, 10);
        }

        function updateCount(elementId, delta) {
            const el = document.getElementById(elementId);
            if (!el) return;

            const current = parseInt(el.textContent || '0', 10);
            el.textContent = Math.max(0, current + delta);
        }

        function removeRow(rowId, countElementId) {
            const row = document.getElementById(rowId);
            if (!row) return;

            row.remove();
            updateCount(countElementId, -1);
        }

        function showToast(message, isSuccess = true) {
            const toastEl = document.getElementById('liveToast');
            const toastMsg = document.getElementById('toastMessage');

            if (!toastEl || !toastMsg || typeof bootstrap === 'undefined') {
                console.log((isSuccess ? 'SUCCESS: ' : 'ERROR: ') + message);
                return;
            }

            toastMsg.textContent = message;
            toastEl.classList.remove('text-bg-primary', 'text-bg-success', 'text-bg-danger');
            toastEl.classList.add(isSuccess ? 'text-bg-success' : 'text-bg-danger');

            const toast = bootstrap.Toast.getOrCreateInstance(toastEl);
            toast.show();
        }

        function renderProductRow(product, rowNumber = 'New') {
            const productId = product.productId ?? product.ProductID ?? '';
            const productName = product.productName ?? product.ProductName ?? '';
            const categoryName = product.categoryName ?? product.CategoryName ?? '';
            const price = product.price ?? product.Price ?? 0;
            const stockQuantity = product.stockQuantity ?? product.StockQuantity ?? 0;
            const status = product.status ?? product.Status ?? 'Pending';
            const mainImage = product.mainImage ?? product.MainImage ?? '';

            return `
                <tr id="product-row-${escapeHtml(productId)}">
                    <td>${rowNumber}</td>
                    <td>${escapeHtml(productId)}</td>
                    <td>
                        ${mainImage
                            ? `<img src="${escapeHtml(mainImage)}" alt="${escapeHtml(productName)}" style="width:60px;height:60px;object-fit:cover;border-radius:6px;" onerror="this.src='/images/no-image.png'" />`
                            : `<img src="/images/no-image.png" alt="No image" style="width:60px;height:60px;object-fit:cover;border-radius:6px;" />`
                        }
                    </td>
                    <td>${escapeHtml(productName)}</td>
                    <td>${escapeHtml(categoryName)}</td>
                    <td>${formatMoney(price)}</td>
                    <td>${escapeHtml(stockQuantity)}</td>
                    <td>${escapeHtml(status)}</td>
                    <td class="text-end">
                        <button type="button" class="btn btn-sm btn-success" onclick="approveProduct('${escapeHtml(productId)}')">Approve</button>
                        <button type="button" class="btn btn-sm btn-danger" onclick="rejectProduct('${escapeHtml(productId)}')">Reject</button>
                    </td>
                </tr>
            `;
        }

        function renderCategoryRow(category, rowNumber = 'New') {
            const categoryId = category.categoryId ?? category.CategoryID ?? '';
            const categoryName = category.categoryName ?? category.CategoryName ?? '';
            const description = category.description ?? category.Description ?? '';
            const status = category.status ?? category.Status ?? 'Pending';

            return `
                <tr id="category-row-${escapeHtml(categoryId)}">
                    <td>${rowNumber}</td>
                    <td>${escapeHtml(categoryId)}</td>
                    <td>${escapeHtml(categoryName)}</td>
                    <td>${escapeHtml(description)}</td>
                    <td>${escapeHtml(status)}</td>
                    <td class="text-end">
                        <button type="button" class="btn btn-sm btn-success" onclick="approveCategory(${categoryId})">Approve</button>
                        <button type="button" class="btn btn-sm btn-danger" onclick="rejectCategory(${categoryId})">Reject</button>
                    </td>
                </tr>
            `;
        }

        function renderVoucherRow(voucher, rowNumber = 'New') {
            const voucherId = voucher.voucherId ?? voucher.VoucherId ?? '';
            const voucherName = voucher.voucherName ?? voucher.VoucherName ?? '';
            const code = voucher.code ?? voucher.Code ?? '';
            const discountPercentage = voucher.discountPercentage ?? voucher.DiscountPercentage;
            const maxReducing = voucher.maxReducing ?? voucher.MaxReducing;
            const quantity = voucher.quantity ?? voucher.Quantity ?? '';
            const expiryDate = voucher.expiryDate ?? voucher.ExpiryDate;
            const isActive = voucher.isActive ?? voucher.IsActive ?? false;

            return `
                <tr id="voucher-row-${escapeHtml(voucherId)}">
                    <td>${rowNumber}</td>
                    <td>${escapeHtml(voucherId)}</td>
                    <td>${escapeHtml(voucherName)}</td>
                    <td>${escapeHtml(code)}</td>
                    <td>${formatPercent(discountPercentage)}</td>
                    <td>${formatMoney(maxReducing)}</td>
                    <td>${escapeHtml(quantity)}</td>
                    <td>${formatDate(expiryDate)}</td>
                    <td>${isActive ? 'Yes' : 'No'}</td>
                    <td class="text-end">
                        <button type="button" class="btn btn-sm btn-success" onclick="approveVoucher(${voucherId})">Approve</button>
                        <button type="button" class="btn btn-sm btn-danger" onclick="rejectVoucher(${voucherId})">Reject</button>
                    </td>
                </tr>
            `;
        }

        function addPendingProductRow(product) {
            const tbody = document.getElementById('productPendingBody');
            if (!tbody) return;

            const productId = product.productId ?? product.ProductID;
            if (!productId) return;
            if (document.getElementById(`product-row-${productId}`)) return;

            const emptyRow = document.getElementById('product-empty-row');
            if (emptyRow) emptyRow.remove();

            tbody.insertAdjacentHTML('afterbegin', renderProductRow(product, 'New'));
            updateCount('product-count', 1);
            showToast('New pending product', true);
        }

        function addPendingCategoryRow(category) {
            const tbody = document.getElementById('categoryPendingBody');
            if (!tbody) return;

            const categoryId = category.categoryId ?? category.CategoryID;
            if (categoryId === null || categoryId === undefined) return;
            if (document.getElementById(`category-row-${categoryId}`)) return;

            const emptyRow = document.getElementById('category-empty-row');
            if (emptyRow) emptyRow.remove();

            tbody.insertAdjacentHTML('afterbegin', renderCategoryRow(category, 'New'));
            updateCount('category-count', 1);
            showToast('New pending category', true);
        }

        function addPendingVoucherRow(voucher) {
            const tbody = document.getElementById('voucherPendingBody');
            if (!tbody) return;

            const voucherId = voucher.voucherId ?? voucher.VoucherId;
            if (voucherId === null || voucherId === undefined) return;
            if (document.getElementById(`voucher-row-${voucherId}`)) return;

            const emptyRow = document.getElementById('voucher-empty-row');
            if (emptyRow) emptyRow.remove();

            tbody.insertAdjacentHTML('afterbegin', renderVoucherRow(voucher, 'New'));
            updateCount('voucher-count', 1);
            showToast('New pending voucher', true);
        }

        async function postApproval(url, payload) {
            const token = getAntiForgeryToken();

            const response = await fetch(url, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                    'RequestVerificationToken': token,
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: new URLSearchParams(payload)
            });

            const contentType = response.headers.get('content-type') || '';
            if (!contentType.includes('application/json')) {
                throw new Error('Invalid server response');
            }

            return await response.json();
        }

        window.approveProduct = async function (id) {
            try {
                const result = await postApproval('/Admin/Approvals/ApproveProduct', { id });
                showToast(result.message, result.success);
            } catch (error) {
                console.error(error);
                showToast('Approve product failed', false);
            }
        };

        window.rejectProduct = async function (id) {
            try {
                const result = await postApproval('/Admin/Approvals/RejectProduct', { id });
                showToast(result.message, result.success);
            } catch (error) {
                console.error(error);
                showToast('Reject product failed', false);
            }
        };

        window.approveCategory = async function (id) {
            try {
                const result = await postApproval('/Admin/Approvals/ApproveCategory', { id });
                showToast(result.message, result.success);
            } catch (error) {
                console.error(error);
                showToast('Approve category failed', false);
            }
        };

        window.rejectCategory = async function (id) {
            try {
                const result = await postApproval('/Admin/Approvals/RejectCategory', { id });
                showToast(result.message, result.success);
            } catch (error) {
                console.error(error);
                showToast('Reject category failed', false);
            }
        };

        window.approveVoucher = async function (id) {
            try {
                const result = await postApproval('/Admin/Approvals/ApproveVoucher', { id });
                showToast(result.message, result.success);
            } catch (error) {
                console.error(error);
                showToast('Approve voucher failed', false);
            }
        };

        window.rejectVoucher = async function (id) {
            try {
                const result = await postApproval('/Admin/Approvals/RejectVoucher', { id });
                showToast(result.message, result.success);
            } catch (error) {
                console.error(error);
                showToast('Reject voucher failed', false);
            }
        };

        pendingConnection.on("PendingProductCreated", function (product) {
            console.log("PendingProductCreated:", product);
            addPendingProductRow(product);
        });

        pendingConnection.on("PendingCategoryCreated", function (category) {
            console.log("PendingCategoryCreated:", category);
            addPendingCategoryRow(category);
        });

        pendingConnection.on("PendingVoucherCreated", function (voucher) {
            console.log("PendingVoucherCreated:", voucher);
            addPendingVoucherRow(voucher);
        });

        pendingConnection.on("ProductApproved", function (data) {
            console.log("ProductApproved:", data);
            removeRow(`product-row-${data.productId}`, 'product-count');
            showToast(`Product ${data.productId} approved`, true);
        });

        pendingConnection.on("ProductRejected", function (data) {
            console.log("ProductRejected:", data);
            removeRow(`product-row-${data.productId}`, 'product-count');
            showToast(`Product ${data.productId} rejected`, false);
        });

        pendingConnection.on("CategoryApproved", function (data) {
            console.log("CategoryApproved:", data);
            removeRow(`category-row-${data.categoryId}`, 'category-count');
            showToast(`Category ${data.categoryId} approved`, true);
        });

        pendingConnection.on("CategoryRejected", function (data) {
            console.log("CategoryRejected:", data);
            removeRow(`category-row-${data.categoryId}`, 'category-count');
            showToast(`Category ${data.categoryId} rejected`, false);
        });

        pendingConnection.on("VoucherApproved", function (data) {
            console.log("VoucherApproved:", data);
            removeRow(`voucher-row-${data.voucherId}`, 'voucher-count');
            showToast(`Voucher ${data.voucherId} approved`, true);
        });

        pendingConnection.on("VoucherRejected", function (data) {
            console.log("VoucherRejected:", data);
            removeRow(`voucher-row-${data.voucherId}`, 'voucher-count');
            showToast(`Voucher ${data.voucherId} rejected`, false);
        });

        async function startSignalR() {
            try {
                await pendingConnection.start();
                console.log("Connected to pending-approval-hub");
            } catch (err) {
                console.error("SignalR connection error:", err);
                setTimeout(startSignalR, 3000);
            }
        }

        startSignalR();
    </script>
}