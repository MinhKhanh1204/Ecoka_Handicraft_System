@model MVCApplication.Areas.Admin.DTOs.ApprovalDto
@using System.Globalization

@{
    ViewData["Title"] = "Approvals";
    var viCulture = new CultureInfo("vi-VN");
}

<form id="antiForgeryForm" style="display:none;">
    @Html.AntiForgeryToken()
</form>

<div class="pagetitle">
    <h1>Approvals</h1>
</div>

<section class="section">
    <div class="card">
        <div class="card-body pt-3">

            <ul class="nav nav-tabs mb-3" id="approvalTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active"
                            id="products-tab"
                            data-bs-toggle="tab"
                            data-bs-target="#products"
                            type="button"
                            role="tab">
                        Products (<span id="product-count">@Model.PendingProducts.TotalCount</span>)
                    </button>
                </li>

                <li class="nav-item" role="presentation">
                    <button class="nav-link"
                            id="categories-tab"
                            data-bs-toggle="tab"
                            data-bs-target="#categories"
                            type="button"
                            role="tab">
                        Categories (<span id="category-count">@Model.PendingCategories.Count</span>)
                    </button>
                </li>

                <li class="nav-item" role="presentation">
                    <button class="nav-link"
                            id="vouchers-tab"
                            data-bs-toggle="tab"
                            data-bs-target="#vouchers"
                            type="button"
                            role="tab">
                        Vouchers (<span id="voucher-count">@Model.PendingVouchers.Count</span>)
                    </button>
                </li>
            </ul>

            <div class="tab-content">

                <!-- PRODUCTS -->
                <div class="tab-pane fade show active" id="products" role="tabpanel">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Product ID</th>
                                    <th>Image</th>
                                    <th>Product</th>
                                    <th>Category</th>
                                    <th>Price</th>
                                    <th>Stock</th>
                                    <th>Status</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="productPendingBody">
                                @if (!Model.PendingProducts.Items.Any())
                                {
                                    <tr id="product-empty-row">
                                        <td colspan="9" class="text-center text-muted">No pending products</td>
                                    </tr>
                                }
                                else
                                {
                                    var index = 0;
                                    foreach (var p in Model.PendingProducts.Items)
                                    {
                                        index++;
                                        <tr id="product-row-@p.ProductID">
                                            <td>@index</td>
                                            <td>@p.ProductID</td>
                                            <td>
                                                <img src="@(string.IsNullOrWhiteSpace(p.MainImage) ? "/images/no-image.png" : p.MainImage)"
                                                     width="55"
                                                     height="55"
                                                     class="rounded"
                                                     style="object-fit:cover"
                                                     alt="Product image"
                                                     onerror="this.src='/images/no-image.png'" />
                                            </td>
                                            <td>@p.ProductName</td>
                                            <td>@p.CategoryName</td>
                                            <td>@p.Price.ToString("C0", viCulture)</td>
                                            <td>@p.StockQuantity</td>
                                            <td>@p.Status</td>
                                            <td class="text-end">
                                                <button type="button" class="btn btn-sm btn-success" onclick="approveProduct('@p.ProductID')">Approve</button>
                                                <button type="button" class="btn btn-sm btn-danger" onclick="rejectProduct('@p.ProductID')">Reject</button>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- CATEGORIES -->
                <div class="tab-pane fade" id="categories" role="tabpanel">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Category ID</th>
                                    <th>Name</th>
                                    <th>Description</th>
                                    <th>Status</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="categoryPendingBody">
                                @if (!Model.PendingCategories.Any())
                                {
                                    <tr id="category-empty-row">
                                        <td colspan="6" class="text-center text-muted">No pending categories</td>
                                    </tr>
                                }
                                else
                                {
                                    var index = 0;
                                    foreach (var c in Model.PendingCategories)
                                    {
                                        index++;
                                        <tr id="category-row-@c.CategoryID">
                                            <td>@index</td>
                                            <td>@c.CategoryID</td>
                                            <td>@c.CategoryName</td>
                                            <td>@c.Description</td>
                                            <td>@c.Status</td>
                                            <td class="text-end">
                                                <button type="button" class="btn btn-sm btn-success" onclick="approveCategory(@c.CategoryID)">Approve</button>
                                                <button type="button" class="btn btn-sm btn-danger" onclick="rejectCategory(@c.CategoryID)">Reject</button>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- VOUCHERS -->
                <div class="tab-pane fade" id="vouchers" role="tabpanel">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Voucher ID</th>
                                    <th>Name</th>
                                    <th>Code</th>
                                    <th>Discount</th>
                                    <th>Max Reducing</th>
                                    <th>Qty</th>
                                    <th>Expiry</th>
                                    <th>Active</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="voucherPendingBody">
                                @if (!Model.PendingVouchers.Any())
                                {
                                    <tr id="voucher-empty-row">
                                        <td colspan="10" class="text-center text-muted">No pending vouchers</td>
                                    </tr>
                                }
                                else
                                {
                                    var index = 0;
                                    foreach (var v in Model.PendingVouchers)
                                    {
                                        index++;
                                        <tr id="voucher-row-@v.VoucherId">
                                            <td>@index</td>
                                            <td>@v.VoucherId</td>
                                            <td>@v.VoucherName</td>
                                            <td>@v.Code</td>
                                            <td>@(v.DiscountPercentage.HasValue? v.DiscountPercentage.Value.ToString("0.##") + "%" : "-")</td>
                                            <td>@(v.MaxReducing.HasValue? v.MaxReducing.Value.ToString("C0", viCulture) : "-")</td>
                                            <td>@v.Quantity</td>
                                            <td>@(v.ExpiryDate.HasValue? v.ExpiryDate.Value.ToString("yyyy-MM-dd") : "-")</td>
                                            <td>@(v?.IsActive == true ? "Yes" : "No")</td>
                                            <td class="text-end">
                                                <button type="button" class="btn btn-sm btn-success" onclick="approveVoucher(@v.VoucherId)">Approve</button>
                                                <button type="button" class="btn btn-sm btn-danger" onclick="rejectVoucher(@v.VoucherId)">Reject</button>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
        </div>
    </div>
</section>

<div class="toast-container position-fixed top-0 end-0 p-3">
    <div id="liveToast" class="toast align-items-center text-bg-primary border-0" role="alert">
        <div class="d-flex">
            <div class="toast-body" id="toastMessage">Notification</div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>

    <script>
        const urls = {
            approveProduct: '@Url.Action("ApproveProduct", "Approvals", new { area = "Admin" })',
            rejectProduct: '@Url.Action("RejectProduct", "Approvals", new { area = "Admin" })',
            approveCategory: '@Url.Action("ApproveCategory", "Approvals", new { area = "Admin" })',
            rejectCategory: '@Url.Action("RejectCategory", "Approvals", new { area = "Admin" })',
            approveVoucher: '@Url.Action("ApproveVoucher", "Approvals", new { area = "Admin" })',
            rejectVoucher: '@Url.Action("RejectVoucher", "Approvals", new { area = "Admin" })'
        };

        function getAntiForgeryToken() {
            return document.querySelector('#antiForgeryForm input[name="__RequestVerificationToken"]')?.value || '';
        }

        function showToast(message, isSuccess = true) {
            const toastEl = document.getElementById('liveToast');
            const msgEl = document.getElementById('toastMessage');

            msgEl.innerText = message;
            toastEl.classList.remove('text-bg-success', 'text-bg-danger', 'text-bg-primary');
            toastEl.classList.add(isSuccess ? 'text-bg-success' : 'text-bg-danger');

            const toast = new bootstrap.Toast(toastEl);
            toast.show();
        }

        function updateCount(id, delta) {
            const el = document.getElementById(id);
            if (!el) return;

            const current = parseInt(el.innerText || '0', 10);
            el.innerText = Math.max(0, current + delta);
        }

        function ensureEmptyRow(tbodyId, emptyRowId, colspan, text) {
            const tbody = document.getElementById(tbodyId);
            if (!tbody) return;

            const realRows = Array.from(tbody.querySelectorAll('tr')).filter(x => x.id !== emptyRowId);
            if (realRows.length === 0 && !document.getElementById(emptyRowId)) {
                const row = document.createElement('tr');
                row.id = emptyRowId;
                row.innerHTML = `<td colspan="${colspan}" class="text-center text-muted">${text}</td>`;
                tbody.appendChild(row);
            }
        }

        function removeRow(rowId, countId) {
            const row = document.getElementById(rowId);
            if (row) {
                row.remove();
                updateCount(countId, -1);
            }

            ensureEmptyRow('productPendingBody', 'product-empty-row', 9, 'No pending products');
            ensureEmptyRow('categoryPendingBody', 'category-empty-row', 6, 'No pending categories');
            ensureEmptyRow('voucherPendingBody', 'voucher-empty-row', 10, 'No pending vouchers');
        }

        async function postAction(url, id, rowId, countId) {
            try {
                const token = getAntiForgeryToken();
                const formData = new FormData();
                formData.append('id', id);

                const response = await fetch(url, {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': token },
                    body: formData
                });

                const rawText = await response.text();
                let result = null;

                try {
                    result = JSON.parse(rawText);
                } catch {
                    console.error('Non-JSON response:', rawText);
                    showToast('Server returned invalid response', false);
                    return;
                }

                if (!response.ok) {
                    showToast(result.message || 'Request failed', false);
                    return;
                }

                if (result.success) {
                    removeRow(rowId, countId);
                    showToast(result.message || 'Success', true);
                } else {
                    showToast(result.message || 'Failed', false);
                }
            } catch (error) {
                console.error(error);
                showToast('Request failed', false);
            }
        }

        function approveProduct(id) {
            postAction(urls.approveProduct, id, `product-row-${id}`, 'product-count');
        }

        function rejectProduct(id) {
            postAction(urls.rejectProduct, id, `product-row-${id}`, 'product-count');
        }

        function approveCategory(id) {
            postAction(urls.approveCategory, id, `category-row-${id}`, 'category-count');
        }

        function rejectCategory(id) {
            postAction(urls.rejectCategory, id, `category-row-${id}`, 'category-count');
        }

        function approveVoucher(id) {
            postAction(urls.approveVoucher, id, `voucher-row-${id}`, 'voucher-count');
        }

        function rejectVoucher(id) {
            postAction(urls.rejectVoucher, id, `voucher-row-${id}`, 'voucher-count');
        }

        function escapeHtml(value) {
            if (value === null || value === undefined) return '';
            return String(value)
                .replaceAll('&', '&amp;')
                .replaceAll('<', '&lt;')
                .replaceAll('>', '&gt;')
                .replaceAll('"', '&quot;')
                .replaceAll("'", '&#39;');
        }

        function formatCurrency(value) {
            if (value === null || value === undefined || value === '') return '';
            const number = Number(value);
            if (Number.isNaN(number)) return escapeHtml(value);
            return new Intl.NumberFormat('vi-VN', {
                style: 'currency',
                currency: 'VND',
                maximumFractionDigits: 0
            }).format(number);
        }

        function renderProductRow(product, rowNumber = 'New') {
            const pid = product.productID || product.ProductID || '';
            const img = product.mainImage || product.MainImage || '/images/no-image.png';
            const productName = product.productName || product.ProductName || '';
            const categoryName = product.categoryName || product.CategoryName || '';
            const price = product.price ?? product.Price ?? '';
            const stock = product.stockQuantity ?? product.StockQuantity ?? '';
            const status = product.status || product.Status || 'Pending';

            return `
                <tr id="product-row-${escapeHtml(pid)}">
                    <td>${rowNumber}</td>
                    <td>${escapeHtml(pid)}</td>
                    <td>
                        <img src="${escapeHtml(img)}"
                             width="55"
                             height="55"
                             style="object-fit:cover"
                             class="rounded"
                             alt="Product image"
                             onerror="this.src='/images/no-image.png'" />
                    </td>
                    <td>${escapeHtml(productName)}</td>
                    <td>${escapeHtml(categoryName)}</td>
                    <td>${formatCurrency(price)}</td>
                    <td>${escapeHtml(stock)}</td>
                    <td>${escapeHtml(status)}</td>
                    <td class="text-end">
                        <button type="button" class="btn btn-sm btn-success" onclick="approveProduct('${escapeHtml(pid)}')">Approve</button>
                        <button type="button" class="btn btn-sm btn-danger" onclick="rejectProduct('${escapeHtml(pid)}')">Reject</button>
                    </td>
                </tr>
            `;
        }

        function renderVoucherRow(voucher, rowNumber = 'New') {
            const id = voucher.voucherId ?? voucher.VoucherId ?? '';
            const voucherName = voucher.voucherName || voucher.VoucherName || '';
            const code = voucher.code || voucher.Code || '';
            const discount = voucher.discountPercentage ?? voucher.DiscountPercentage;
            const maxReducing = voucher.maxReducing ?? voucher.MaxReducing;
            const quantity = voucher.quantity ?? voucher.Quantity ?? '-';
            const expiry = voucher.expiryDate ?? voucher.ExpiryDate ?? '-';
            const isActive = voucher.isActive ?? voucher.IsActive;

            return `
                <tr id="voucher-row-${escapeHtml(id)}">
                    <td>${rowNumber}</td>
                    <td>${escapeHtml(id)}</td>
                    <td>${escapeHtml(voucherName)}</td>
                    <td>${escapeHtml(code)}</td>
                    <td>${discount !== null && discount !== undefined ? escapeHtml(discount + '%') : '-'}</td>
                    <td>${maxReducing !== null && maxReducing !== undefined ? formatCurrency(maxReducing) : '-'}</td>
                    <td>${escapeHtml(quantity)}</td>
                    <td>${escapeHtml(expiry)}</td>
                    <td>${isActive ? 'Yes' : 'No'}</td>
                    <td class="text-end">
                        <button type="button" class="btn btn-sm btn-success" onclick="approveVoucher(${id})">Approve</button>
                        <button type="button" class="btn btn-sm btn-danger" onclick="rejectVoucher(${id})">Reject</button>
                    </td>
                </tr>
            `;
        }

        function addPendingProductRow(product) {
            const tbody = document.getElementById('productPendingBody');
            const emptyRow = document.getElementById('product-empty-row');
            if (!tbody) return;

            const pid = product.productID || product.ProductID;
            if (!pid) return;
            if (document.getElementById(`product-row-${pid}`)) return;

            if (emptyRow) emptyRow.remove();
            tbody.insertAdjacentHTML('afterbegin', renderProductRow(product, 'New'));
            updateCount('product-count', 1);
            showToast('New pending product', true);
        }

        function addPendingVoucherRow(voucher) {
            const tbody = document.getElementById('voucherPendingBody');
            const emptyRow = document.getElementById('voucher-empty-row');
            if (!tbody) return;

            const id = voucher.voucherId ?? voucher.VoucherId;
            if (id === null || id === undefined) return;
            if (document.getElementById(`voucher-row-${id}`)) return;

            if (emptyRow) emptyRow.remove();
            tbody.insertAdjacentHTML('afterbegin', renderVoucherRow(voucher, 'New'));
            updateCount('voucher-count', 1);
            showToast('New pending voucher', true);
        }

        const pendingConnection = new signalR.HubConnectionBuilder()
            .withUrl('/pending-approval-hub')
            .withAutomaticReconnect()
            .build();

        pendingConnection.on('PendingProductCreated', function (product) {
            console.log('PendingProductCreated:', product);
            addPendingProductRow(product);
        });

        pendingConnection.on('PendingVoucherCreated', function (voucher) {
            console.log('PendingVoucherCreated:', voucher);
            addPendingVoucherRow(voucher);
        });

        pendingConnection.on('ProductApproved', function (data) {
            removeRow(`product-row-${data.productId}`, 'product-count');
            showToast(`Product ${data.productId} has been approved by another admin`, true);
        });

        pendingConnection.on('ProductRejected', function (data) {
            removeRow(`product-row-${data.productId}`, 'product-count');
            showToast(`Product ${data.productId} has been rejected by another admin`, false);
        });

        pendingConnection.on('VoucherApproved', function (data) {
            removeRow(`voucher-row-${data.voucherId}`, 'voucher-count');
            showToast(`Voucher ${data.voucherId} has been approved by another admin`, true);
        });

        pendingConnection.on('VoucherRejected', function (data) {
            removeRow(`voucher-row-${data.voucherId}`, 'voucher-count');
            showToast(`Voucher ${data.voucherId} has been rejected by another admin`, false);
        });

        pendingConnection.start()
            .then(() => console.log('SignalR connected for PendingApprovalHub'))
            .catch(err => console.error('SignalR connection error (PendingApprovalHub):', err));
    </script>
}