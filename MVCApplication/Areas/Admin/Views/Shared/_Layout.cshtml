@using System.Security.Claims
@{
    var profileAccountId = User.FindFirst("accountID")?.Value;
    var profileUsername = User.Identity?.Name ?? User.FindFirst("username")?.Value ?? "";
    var profileRoleRaw = User.FindAll("role").Select(c => c.Value).FirstOrDefault();
    var profileRoleVi = profileRoleRaw switch
    {
        "Admin" => "Quản trị viên",
        "Employee" => "Nhân viên",
        "Staff" => "Nhân viên",
        _ => profileRoleRaw ?? ""
    };
}

